---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  title: string;
  date: Date;
  excerpt: string;
  tags: string[];
  readingTime: number;
  entry: string;
  ogImage?: string;
  draft?: boolean;
}

const { title, date, excerpt, tags, readingTime, entry, ogImage, draft } = Astro.props;
// Dev only. A draft that renders identically to a published post is how one gets forgotten,
// or worse, read as already live.
const showDraftBanner = import.meta.env.DEV && draft;
const base = import.meta.env.BASE_URL;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// BlogPosting, not TechArticle: Google's Article docs say the type "must be based on one of
// Article, NewsArticle, BlogPosting" and never mention subtypes. Search Console has no rich-result
// report for Articles, so a wrong type here is unflaggable — validate with the Rich Results Test.
// image is emitted only when the post has a real ogImage; the og-default fallback would violate
// Google's "images must represent the marked up content" rule.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": excerpt,
  "datePublished": date.toISOString(),
  ...(ogImage ? { "image": new URL(ogImage, Astro.site).href } : {}),
  "author": {
    "@type": "Person",
    "name": "Marko Stankovic",
    "url": "https://markostankovic.org"
  },
  "publisher": {
    "@type": "Person",
    "name": "Marko Stankovic",
    "url": "https://markostankovic.org"
  }
};
---

<BaseLayout
  title={`${title} | Marko Stankovic`}
  description={excerpt}
  ogImage={ogImage}
  ogType="article"
  codeHighlighting={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

    <style is:global>
      /* ── Reading progress bar ── */
      #reading-progress-track {
        position: fixed;
        top: 56px; /* matches navbar h-14 */
        left: 0;
        width: 100%;
        height: 3px;
        /* Was a white veil at low alpha, built for the dark page: on the light
           background it rendered as nothing, so the teal fill floated with no
           track behind it. Same class as the inline-code fix below, and missed by
           the same #hex-only sweep. The old value is deliberately not spelled out,
           so a future colour sweep does not trip on the comment recording the fix. */
        background: var(--color-border);
        z-index: 10000;
        pointer-events: none;
      }
      #reading-progress-fill {
        height: 100%;
        width: 0%;
        background: var(--aurora-ramp);
        will-change: width;
      }

      /* Night post (issue 12, map-site-v3 ticket 03 + 06). The post surface IS the
         night band: the locked night tokens are mapped onto the light roles the
         layout and global.css already read, so every rule below and every
         Tailwind var class keeps working and no second set of rules is needed.
         On body rather than on a wrapper so the fixed nav, the top accent line
         and the selection colour follow the page too. This block is inlined
         only on pages built through this layout. --color-surface is NOT
         remapped: the code blocks stay white cards because highlight.js's github
         theme is tuned against white (global.css, "Code blocks"), and inline
         code takes the cyan-alpha border token as its chip. --color-warm is
         NOT remapped either: on a post its only readers are the dev-only draft
         banner and the hljs built_in/symbol tokens on that white card, where
         the amber measures 2.40 on white against the light warm's 5.22. */
      body {
        --color-bg: var(--color-night-bg);
        --color-surface-veil: var(--color-night-surface);
        --color-surface-raised: var(--color-night-surface);
        --color-border: var(--color-night-border);
        --color-border-strong: var(--color-night-border);
        --color-text-primary: var(--color-night-text);
        --color-text-secondary: var(--color-night-text-secondary);
        --color-text-muted: var(--color-night-text-secondary);
        --color-accent: var(--color-aurora-cyan);
        --color-accent-dim: var(--color-night-border);
        --color-grid: var(--color-night-border);
        background-color: var(--color-night-bg);
      }
      /* Code blocks go dark on the night page (Marko, 2026-08-23): the hljs theme on
         post pages is github-dark (BaseLayout), tuned against #0d1117, so the card
         takes the night surface over navy and the night border; the light-era
         warm override for built_in/symbol is lifted here because github-dark's own
         token colours were measured against a dark ground. */
      .prose pre code.hljs,
      pre code.hljs {
        background: var(--color-night-surface);
        border-color: var(--color-night-border);
      }
      .prose pre code.hljs .hljs-built_in,
      .prose pre code.hljs .hljs-symbol,
      pre code.hljs .hljs-built_in,
      pre code.hljs .hljs-symbol {
        color: inherit;
      }
      /* The copy button sits on the white card. Its three states are restated
         here at (0,2,0) because global.css's :hover and .copied rules are
         (0,2,0) too and they read the remapped tokens: .copied would have set
         cyan text on the cyan base, invisible under (hover: none). */
      .copy-btn {
        color: var(--color-night-bg);
        background: var(--color-aurora-cyan);
        border-color: var(--color-aurora-cyan);
      }
      .copy-btn:hover {
        color: var(--color-aurora-cyan);
        background: var(--color-night-bg);
        border-color: var(--color-aurora-cyan);
      }
      .copy-btn.copied {
        color: var(--color-night-bg);
        background: var(--color-night-text);
        border-color: var(--color-night-text);
      }

      /* The ONE scroll-synced element on the site (ticket 06). .night-post spans
         the page; the plexus is an absolute child whose HEIGHT equals the scroll
         distance (100% of the page minus one viewport), so a keyframe ending at
         translateY(80%) moves it 0.8 x scrollY down the document, which is 0.2 x
         scroll speed past the viewport, and reverses with the scrollbar. The
         timeline is the root scroller. The svg runs one viewport taller than
         its box so the tile still covers the screen at the end of the page.

         isolation + z-index:-1 keeps it under the in-flow content without the
         `> * { position: relative }` catch-all that ate new children on the
         home prototype (knowledge: concept-css-band-graphics-fixed-geometry).
         The animation sits inside @supports on purpose: outside it, a browser
         without scroll timelines would run a 0s time animation and freeze the
         layer at its END state, and the fallback script below has nothing to
         fall back from. CSS.supports in that script asks the same question.
         Reduced motion: the animation is off and the layer is static in the
         page; the script checks the same media query and does nothing. */
      .night-post {
        position: relative;
        isolation: isolate;
        overflow: clip;
      }
      .plexus {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: calc(100% - 100vh);
        z-index: -1;
        pointer-events: none;
        overflow: visible;
      }
      .plexus svg {
        display: block;
        width: 100%;
        height: calc(100% + 100vh);
      }
      .plexus .n0 { fill: var(--aurora-0); }
      .plexus .n1 { fill: var(--aurora-1); }
      .plexus .n2 { fill: var(--aurora-2); }
      .plexus .n3 { fill: var(--aurora-3); }
      .plexus .e { stroke: var(--color-aurora-cyan); stroke-opacity: 0.2; stroke-width: 1; }
      .plexus .s { fill: var(--color-night-text); }
      @keyframes plexus-drift {
        from { transform: translateY(0); }
        to { transform: translateY(80%); }
      }
      @supports (animation-timeline: scroll()) {
        .plexus {
          animation: plexus-drift linear both;
          animation-timeline: scroll(root block);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .plexus { animation: none; }
      }

      /* The mono entry line, "Field journal · Entry NN · date". The journal
         name is the way back to the index; the date sits here and not in the
         meta row under the title, so it is printed once. */
      .entry-line {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        color: var(--color-text-muted);
        margin-bottom: 1.25rem;
      }
      .entry-line a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .entry-line a:hover { color: var(--color-accent); }
      .entry-line .sep { color: var(--color-border-strong); }

      /* ── Code blocks ──
         The surface lives in global.css, which beat this rule on specificity
         (.prose pre code.hljs over pre code.hljs). This copy disagreed with it
         on background and border-radius and had never applied, so it is gone
         rather than left as a second source of truth. */

      /* ── Copy button ──
         Second source of truth, deleted 2026-08-15. This block disagreed with
         global.css on background, radius and hover-reveal, and it WON: Astro
         inlines a layout's is:global styles after the linked bundle, so the
         post surface was running a dark-era copy of a rule ticket 03 had
         already audited on the project page.

         CORRECTED 2026-08-15 by measuring instead of reading. This comment
         first claimed the block's one real contribution was that the button
         had no `opacity: 0`, and that this was the only reason it was
         reachable on a phone. It was not: the block declared no opacity at
         all, so global.css's `opacity: 0` applied on main too, and the button
         was hover-only on touch before this change exactly as it is after.
         A `(hover: none)` rule was written on that false premise and has been
         reverted, because it silently unhid the button on /projects/deploylog/
         as well, where at 390px it sits on the first line of the code block.
         The real defect (a hover-only control on a touch device, site-wide and
         pre-existing) is recorded for ticket 10 with the focus-visible one. */

      /* The body band's inner wrapper. It exists only so the breakout rules can
         ask the container how wide it actually is instead of recomputing it
         from `max-w-3xl` minus `px-6` twice, which is Tailwind arithmetic done
         100 lines away in a different language. Nothing else changes: the box
         keeps its width, its centring and its gutters. */
      .reading-container {
        container-type: inline-size;
      }

      /* ── Long-form register, set 2026-08-15 (issues/map-site-v2/09) ──
         Four numbers, each one derived rather than picked.

         SIZE. The rest of the site is a scanning surface and sets body at
         0.98-1.05rem. This is the one surface someone reads for eight minutes,
         so it takes one step up to 1.125rem / 18px. It is now the largest body
         text on the site, deliberately.

         LEADING. 1.85 came from the dark page, where light-on-dark needs the
         extra air. 1.7 at 18px is 30.6px of leading against the old 31.1px, so
         the rhythm is unchanged and only the glyphs grew.

         MEASURE. 680px was a round number inherited from the dark build, and it
         rendered 86 characters per line — measured in a real post, not counted
         off the CSS. 31em is 558px, which measures 70. The first attempt here
         was 68ch, copied from the home page's reading column, and it did
         nothing at all: Geist's `0` advance is 11.92px at 18px against an
         average character advance of 7.95px, so 68ch resolves to 810px and
         never reached the 720px container. The home page's own 68ch has the
         same problem and is decoration there too — recorded in ticket 09, not
         changed here, because that page's columns are bounded by its grid.

         ALIGNMENT. There is deliberately no `margin-inline: auto` here. The
         column sits flush left in the 720px container, so the page carries two
         right edges: text ends at 558px, the hero and the media above and below
         it run the full 720. That is load-bearing rather than incidental, and
         it is what the breakout rule below depends on: a centred .prose would
         leave `width: 100cqi` overflowing 81px to the right only, because a
         block box wider than its parent overflows one way, not symmetrically.
         Centre the column and the images have to be centred by hand.

         COLOUR. Body was --color-text-secondary, a role meant for supporting
         text, measuring 5.86 against the page. On a light page the body IS the
         page: --color-text-primary measures 16.2. */
      .prose {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-primary);
        max-width: 31em;
        /* Centred in the 720px reading container (Marko, 2026-08-23); the code
           breakout below pulls itself back to the container edges with a
           negative inline margin, since cqi measures the container, not .prose. */
        margin-inline: auto;
      }

      .prose p {
        margin-bottom: 1.4rem;
      }

      /* Sans, and no `// ` prefix. Mono survives on this direction for small
         metadata only (ticket 03; index.astro and call.astro both scope the
         prefix off the same way). h2 is 1.4rem against a 1.125rem body — the
         same 1.24 ratio the home page runs at its own smaller scale, so the
         hierarchy holds after the body grew. */
      .prose h2,
      .prose h3 {
        font-family: var(--font-sans);
        color: var(--color-text-primary);
        letter-spacing: -0.01em;
        margin-top: 3rem;
        margin-bottom: 0.6rem;
        line-height: 1.25;
      }

      .prose h2 {
        font-size: 1.4rem;
        font-weight: 600;
      }

      /* No published post contains an h3 — 0 of 16 across the whole collection,
         counted not assumed. It is set anyway because the body bump would
         otherwise leave h3 SMALLER than the paragraphs under it, and the first
         post to use one would ship that. */
      .prose h3 {
        font-size: 1.15rem;
        font-weight: 600;
        margin-top: 2rem;
      }

      /* Inline code */
      .prose :not(pre) > code {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.875em;
        color: var(--color-accent);
        /* Was the retired dark-brand cyan at 8% alpha. Ticket 08's literal sweep
           matched #hex only, so an rgba() literal never showed up. The old value
           is deliberately not spelled out here, so a future colour sweep does not
           trip on the comment that records the fix. */
        background: var(--color-accent-dim);
        padding: 0.15em 0.4em;
        /* 27 of these across the four published posts, second only to the
           paragraph itself. Square corners were the only ones left on a
           direction whose controls are 6px and whose cards are 10px. */
        border-radius: 3px;
        /* Long flag names wrap: `--no-baseline-gate` breaks over two lines in
           the published post. Without this the second fragment loses its
           padding and radius and reads as a rendering fault. */
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }

      /* Code blocks: wrap in .pre-wrap via JS */
      .prose pre {
        margin-bottom: 1.5rem;
      }

      /* The measure is for sentences, and these are not sentences. Narrowing the
         column to 558px clipped the code block's own lines against its border
         — caught in a screenshot after the change, not predicted — and shrank a
         chart below the size it was drawn at. All of them step back out to the
         full width of the reading container they sit in. .prose pre is listed as
         well as .pre-wrap because the wrapper is added by script and does not
         exist until it runs; figcaption is listed because it centres itself, and
         centring inside the 558px column would put a caption 81px left of the
         image it labels (no post emits a figure yet, so this ships before the
         first one rather than after it, same reasoning as h3 above).

         100cqi rather than calc(100vw - 3rem): vw counts the scrollbar, so the
         first version ran 6px wider than its own container on any desktop window
         under ~774px, and wider still in Firefox, which ignores the 6px
         ::-webkit-scrollbar. The container query measures the real layout box,
         so it is exact at every width and hardcodes no width at all. The literal
         pair is kept underneath as the fallback for a browser without container
         queries, where it is dropped as invalid and the old behaviour stands. */
      .prose .pre-wrap,
      .prose pre {
        width: 720px;
        max-width: calc(100vw - 3rem);
        width: 100cqi;
        max-width: 100cqi;
        margin-inline: calc(50% - 50cqi);
      }
      .prose .pre-wrap pre { margin-inline: 0; }

      /* Blockquotes */
      /* Ticket 03 (2026-08-22): Marko read the 558px text column against 720px
         figures as "not synced". Images and captions come back to the measure;
         code blocks keep the breakout above because narrowing them clipped lines. */
      .prose img,
      .prose figcaption {
        width: 100%;
        max-width: 100%;
      }

      .prose blockquote {
        border-left: 2px solid var(--color-accent);
        padding-left: 1.25rem;
        margin-left: 0;
        color: var(--color-text-secondary);
        font-style: italic;
      }

      /* Images. The breakout lives in the shared rule above; only the paint is
         here. It was briefly duplicated instead, on the reasoning that this
         block is later in the file and its width:100% won on source order —
         true of the width:100% that the same change then deleted, so the
         justification expired inside its own commit. */
      .prose img {
        border: 1px solid var(--color-border);
        display: block;
        margin: 1.5rem 0 0.5rem;
      }

      .prose figcaption {
        text-align: center;
        font-size: 0.8rem;
        font-family: 'JetBrains Mono', monospace;
        color: var(--color-text-muted);
        margin-bottom: 1.5rem;
      }

      /* HR */
      .prose hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2rem 0;
      }

      /* Links. The old rule hid the underline until hover and coloured the link
         the same as the body, which on the dark page was survivable and on this
         one leaves a link indistinguishable from a sentence. No published post
         has an inline link yet (0 across the four), so this ships before it is
         needed rather than after. */
      .prose a {
        color: var(--color-text-primary);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        transition: color 0.15s ease;
      }

      .prose a:hover {
        color: var(--color-accent);
      }

      /* Lists */
      .prose ul,
      .prose ol {
        padding-left: 1.5rem;
        margin-bottom: 1.4rem;
      }

      .prose li {
        margin-bottom: 0.4rem;
      }

      .prose ul li::marker {
        color: var(--color-accent);
      }

      .prose ol li::marker {
        color: var(--color-text-muted);
        font-family: 'JetBrains Mono', monospace;
      }
    </style>


    <!-- ─── READING PROGRESS BAR ────────────────────────────────────────── -->
    <div id="reading-progress-track" aria-hidden="true">
      <div id="reading-progress-fill"></div>
    </div>

    <SiteNav active="journal" />

    <div class="night-post">
    <!-- The plexus layer: one 480px tile of nodes and edges, repeated. Colours are
         CSS classes, not fill attributes, so the tokens resolve. -->
    <div class="plexus" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <defs>
          <filter id="plexus-glow"><feGaussianBlur stdDeviation="6" /></filter>
          <pattern id="plexus-tile" width="480" height="480" patternUnits="userSpaceOnUse">
            <g filter="url(#plexus-glow)" opacity="0.3">
              <circle class="n0" cx="96" cy="112" r="11" />
              <circle class="n1" cx="318" cy="64" r="14" />
              <circle class="n2" cx="404" cy="236" r="12" />
              <circle class="n3" cx="188" cy="342" r="15" />
              <circle class="n1" cx="42" cy="418" r="10" />
              <circle class="n2" cx="266" cy="190" r="9" />
            </g>
            <g class="e">
              <line x1="96" y1="112" x2="266" y2="190" />
              <line x1="266" y1="190" x2="318" y2="64" />
              <line x1="266" y1="190" x2="404" y2="236" />
              <line x1="266" y1="190" x2="188" y2="342" />
              <line x1="188" y1="342" x2="42" y2="418" />
              <line x1="404" y1="236" x2="452" y2="372" />
              <line x1="318" y1="64" x2="150" y2="22" />
              <line x1="96" y1="112" x2="150" y2="22" />
              <line x1="42" y1="418" x2="96" y2="112" />
              <line x1="452" y1="372" x2="188" y2="342" />
            </g>
            <g class="s">
              <circle cx="96" cy="112" r="1.6" />
              <circle cx="318" cy="64" r="1.6" />
              <circle cx="404" cy="236" r="1.4" />
              <circle cx="188" cy="342" r="1.8" />
              <circle cx="42" cy="418" r="1.3" />
              <circle cx="266" cy="190" r="1.5" />
              <circle cx="452" cy="372" r="1.2" />
              <circle cx="150" cy="22" r="1.2" />
              <circle cx="360" cy="440" r="1" />
              <circle cx="230" cy="270" r="0.9" />
            </g>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#plexus-tile)" />
      </svg>
    </div>

    <main>
    <!-- ─── POST HERO ──────────────────────────────────────────────────────── -->
    <div class="relative pt-14">
      <!-- pb was 4rem and the body band below opens with another 4rem, so the
           byline and the first paragraph sat ~155px apart with a rule floating
           in the middle of it. 2.5rem + 3rem reads as one divided block. -->
      <div class="relative max-w-3xl mx-auto px-6 pt-16 pb-10">
        {showDraftBanner && (
          <div class="mb-5 px-4 py-3 font-mono text-xs" style="border: 1px solid var(--color-warm); color: var(--color-warm); background: rgba(217,154,94,0.06);">
            DRAFT. Visible because this is the dev server. It is excluded from every build, so it
            is not on the live site.
          </div>
        )}

        <p class="hero-enter entry-line" style="--delay: 0.05s">
          <a href="/field-journal">Field journal</a> <span class="sep" aria-hidden="true">·</span> Entry {entry} <span class="sep" aria-hidden="true">·</span> <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>
        </p>

        <!-- Sans, 600, and the same clamp call.astro and index.astro run. The
             mono h1 at 2.75rem was the loudest thing left of the dark register:
             on this post it set three lines of JetBrains Mono and took the whole
             fold before a reader reached a sentence.

             The family is set inline, not with Tailwind's font-sans. Tailwind v4
             puts its utilities in @layer utilities, and global.css's unlayered
             `h1, h2, h3 { font-family: var(--font-mono) }` beats any layered
             rule regardless of specificity, so the first attempt used the class
             and rendered mono, unchanged. index.astro and call.astro dodge this
             by writing the family in a scoped style block, which is also
             unlayered. Verified in the built page, not assumed.

             Two notes for whoever edits this comment next, both bought by
             gate.mjs check 5. Its comment skip only matches a comment's FIRST
             line, so an em dash on a wrapped line like this one is linted as
             copy and fails the gate. And it flips its skip state on any line
             matching a style, pre or script open tag, prose included, with no
             close tag to flip it back: spelling that tag out here blinded the
             lint for the remaining 140 lines of the file. Both defects are the
             gate's, not this file's, and are recorded for ticket 10. -->
        <h1 class="hero-enter font-semibold text-[var(--color-text-primary)] mb-5" style="font-family: var(--font-display, var(--font-sans)); font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.15; letter-spacing: -0.02em; --delay: 0.15s">
          {title}
        </h1>

        <div class="hero-enter flex flex-wrap items-center gap-4 mb-5" style="--delay: 0.25s">
          <span class="font-mono text-sm text-[var(--color-text-muted)]">{readingTime} min read</span>
        </div>

        <div class="hero-enter flex flex-wrap gap-2 mb-6" style="--delay: 0.35s">
          {tags.map(tag => (
            <span class="text-xs font-mono text-[var(--color-text-secondary)] border border-[var(--color-border-strong)] rounded-md px-3 py-1">
              {tag}
            </span>
          ))}
        </div>

        <!-- The lede is prose, so it takes a measure too. It was the last thing
             on the reading surface still running the inherited 720px container:
             87 characters across three lines, directly above a body column set
             to 70. 31em against its own 16.8px is 521px, which lands at the same
             70 the body measures, so the two blocks of prose agree. It stays
             flush left with everything else in the hero. -->
        <p class="hero-enter text-[var(--color-text-secondary)] leading-relaxed" style="font-size: 1.05rem; max-width: 31em; --delay: 0.45s">
          {excerpt}
        </p>

        <div class="hero-enter mt-6 pt-6 border-t border-[var(--color-border)] flex items-center gap-2 text-sm" style="--delay: 0.5s">
          <span class="text-[var(--color-text-muted)]">By</span>
          <a href="/" class="font-mono text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150">Marko Stankovic</a>
        </div>
      </div>
    </div>

    <!-- ─── POST BODY ──────────────────────────────────────────────────────── -->
    <div class="border-t border-[var(--color-border)]/50 pt-12 pb-16">
      <div class="reading-container max-w-3xl mx-auto px-6">
        <article class="prose">
          <slot />
        </article>
      </div>
    </div>

    </main>

    <!-- ─── FOOTER ────────────────────────────────────────────────────────── -->
    <footer class="border-t border-[var(--color-border)]/50 py-10">
      <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <a
          href="/field-journal"
          class="nav-link inline-flex items-center text-sm font-mono text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150"
        >
          more posts
        </a>
        <p class="text-[var(--color-text-muted)] text-xs font-mono">© 2026 Marko Stankovic</p>
      </div>
    </footer>
    </div>

    <script>
      // Plexus scroll-sync fallback (issue 12). Only where the CSS scroll timeline
      // is missing and motion is allowed; mirrors the keyframe exactly (0.8 x
      // scrollY down the document = 0.2 x scroll speed), so both paths agree.
      if (!CSS.supports('animation-timeline: scroll()') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const plx = document.querySelector<HTMLElement>('.plexus');
        const drift = () => { if (plx) plx.style.transform = `translateY(${scrollY * 0.8}px)`; };
        addEventListener('scroll', drift, { passive: true });
        drift();
      }

      // ── Reading progress bar ──────────────────────────────────────────────
      (function () {
        const bar = document.getElementById('reading-progress-fill');
        const article = document.querySelector('article.prose');
        if (!bar || !article) return;

        let ticking = false;

        function updateProgress() {
          const rect = article.getBoundingClientRect();
          const articleDocTop = rect.top + window.scrollY;
          const scrollable = articleDocTop + article.offsetHeight - window.innerHeight;
          const progress = scrollable > 0
            ? Math.min(Math.max(window.scrollY / scrollable, 0), 1)
            : 0;
          bar.style.width = (progress * 100) + '%';
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });

        // Set initial state
        updateProgress();
      })();

      // Normalise MDX fence language class so hljs uses the full grammar
      document.querySelectorAll('code.language-cs').forEach(el => {
        el.classList.remove('language-cs');
        el.classList.add('language-csharp');
      });

      // Syntax highlighting
      // @ts-ignore
      if (typeof hljs !== 'undefined') hljs.highlightAll();
      document.addEventListener('DOMContentLoaded', () => {
        // @ts-ignore
        if (typeof hljs !== 'undefined') hljs.highlightAll();
      });

      // Wrap pre blocks in .pre-wrap and add copy button
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('article.prose pre').forEach((pre) => {
          const wrap = document.createElement('div');
          wrap.className = 'pre-wrap';
          pre.parentNode?.insertBefore(wrap, pre);
          wrap.appendChild(pre);

          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.textContent = 'copy';
          btn.setAttribute('aria-label', 'Copy code');
          wrap.appendChild(btn);

          btn.addEventListener('click', () => {
            const code = pre.querySelector('code');
            const text = code?.textContent ?? '';
            navigator.clipboard.writeText(text).then(() => {
              btn.textContent = 'copied!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = 'copy';
                btn.classList.remove('copied');
              }, 2000);
            });
          });
        });
      });

    </script>
</BaseLayout>
