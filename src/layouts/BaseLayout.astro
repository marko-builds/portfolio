---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  codeHighlighting?: boolean;
}

const {
  title = "Marko Stankovic | I build AI systems and prove they work",
  description = "AI engineer in Serbia. A demo shows an AI feature running, not whether it worked. I build the tools that measure the difference, and I publish the numbers.",
  ogImage,
  ogType = "website",
  codeHighlighting = false,
} = Astro.props;

const canonicalURL = Astro.url.href;
// og-default-v2.png, 2026-08-15: v1 still read "Developer / I build software products and ship
// them" in baked pixels, so every link preview shipped the retired positioning. Source and
// renderer live in the monolith at play/og_card_portfolio.html + render_og_card.sh — v1 had no
// source at all, which is why no text sweep could find the stale copy. New FILENAME on purpose:
// LinkedIn, X and Slack cache an OG image against its URL, so replacing v1 in place would keep
// serving the old card to everyone who already scraped it.
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL("/og-default-v2.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="E7tgw1T5tN33WpBtQKaMPTkM6sIjSQEnNr33vyw-0ys" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Marko Stankovic · Devlog"
      href={new URL("/rss.xml", Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Page-specific head additions (JSON-LD, extra meta, etc.) -->
    <slot name="head" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- highlight.js (opt-in) -->
    {codeHighlighting && (
      <>
        <link
          rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/styles/github.min.css"
        />
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/highlight.min.js"></script>
      </>
    )}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-70DNV713QD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-70DNV713QD');
    </script>
  </head>

  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
