---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";

// issues/map-site-v2/05-call-page.md. Survey first, scheduler last, CV alongside.
//
// Marko's calls on 2026-08-15, made when this ticket was built:
//   * The CV link is unconditional on this page. It is not gated behind the
//     survey and it appears nowhere else on the site (map decision 9, reversed).
//     A recruiter who only wants to skim gets one click and no form.
//   * The survey posts to the Formspree form that predates the 2026-07-03
//     rebuild. The map called it "already wired for the contact form"; the form
//     was deleted in cfdd76c and only this endpoint survived, in git history.
//     Nothing shares its quota now.
const FORMSPREE_ACTION = "https://formspree.io/f/xlgpgwva";

// Google Calendar appointment schedule, created and booked end to end by Marko
// on 2026-08-15. A short link: it 302s to the real schedule under
// calendar.google.com/appointments/schedules/. Invites come from the account
// itself, the owner's personal Gmail, and not from contact@markostankovic.org; a Gmail
// send-as alias does not apply to calendar invites, so changing that would mean
// a paid Workspace subscription on the domain. Accepted, decided the same day.
const BOOKING_URL = "https://calendar.app.google/ZHVuzrAWxYp4YvhW9";

// The submit is AJAX (fetch + Accept: application/json), which Formspree lists as
// available on every plan. The hidden `_next` redirect this page was first built
// on is NOT: it has left their special-fields list, and the custom thank-you
// redirect that replaced it is documented "Available on: Personal, Professional,
// Business plans". With JS off the form still posts normally and lands on
// Formspree's own thank-you page, which is the free plan's default behaviour.
const CONTACT_EMAIL = "contact@markostankovic.org";

const purposes = [
  "Hiring for a role",
  "A project of mine",
  "Working on something together",
  "Something else",
];

const pageTitle = "Book a call | Marko Stankovic";
const pageDescription =
  "Pick a slot to talk. Tell me what the call is about first, and read the CV while you are here.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <style is:global>
    /* Night register (Marko, 2026-08-23): the body-level token remap BlogPost.astro
       runs on the post pages and projects/deploylog.astro copied verbatim, so the
       fixed nav and every role this page reads take the night tokens. */
    body {
      --color-bg: var(--color-night-bg);
      --color-surface-veil: var(--color-night-surface);
      --color-surface-raised: var(--color-night-surface);
      --color-border: var(--color-night-border);
      --color-border-strong: var(--color-night-border);
      --color-text-primary: var(--color-night-text);
      --color-text-secondary: var(--color-night-text-secondary);
      --color-text-muted: var(--color-night-text-secondary);
      --color-accent: var(--color-aurora-cyan);
      --color-accent-dim: var(--color-night-border);
      --color-grid: var(--color-night-border);
      background-color: var(--color-night-bg);
    }
  </style>

  <SiteNav active="contact" />

  <main class="page">
    <div class="head band">
      <div class="frame">
        <p class="entry-line">
          <a href="/#contact">Send word</a> <span class="sep" aria-hidden="true">·</span> Book a call
        </p>
        <h1>Book a call</h1>
        <p class="lede">
          Pick a slot that works for you. If you tell me what it is about first, I show
          up already knowing the context.
        </p>
      </div>
    </div>

    <div class="body band">
      <div class="frame">
      <!-- 1. THE SURVEY. Optional by design: a form in front of a recruiter is
           friction on the primary audience. -->
      <section class="sec" id="survey">
        <h2>What is the call about?</h2>
        <p class="sec-intro" id="survey-intro">
          Optional. Skip it and book a slot if you would rather just talk.
        </p>

        <p class="sent-note" id="sent-note" hidden>
          Got it, thanks. Pick a slot below and I will see you there.
        </p>

        <p class="err-note" id="err-note" hidden>
          That did not send. Email <a class="inline-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>,
          or skip it and pick a slot below.
        </p>

        <form
          id="survey-form"
          class="survey"
          action={FORMSPREE_ACTION}
          method="POST"
        >
          <!-- `subject` without the underscore: that is the spelling Formspree's
               current special-fields list documents. -->
          <input type="hidden" name="subject" value="markostankovic.org: call request" />
          <!-- Formspree's honeypot, still documented on all plans. A human never
               sees it, a bot fills it, and the submission is dropped. -->
          <p class="gotcha" aria-hidden="true">
            <label for="cf-gotcha">Leave this empty</label>
            <input type="text" id="cf-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </p>

          <div class="pair">
            <div class="field">
              <label for="cf-name">Your name</label>
              <input type="text" id="cf-name" name="name" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input type="email" id="cf-email" name="email" required autocomplete="email" />
            </div>
          </div>

          <div class="field">
            <label for="cf-purpose">Purpose</label>
            <select id="cf-purpose" name="purpose">
              {purposes.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>

          <div class="pair">
            <div class="field">
              <label for="cf-role">Role</label>
              <input type="text" id="cf-role" name="role" autocomplete="organization-title" />
            </div>
            <div class="field">
              <label for="cf-company">Company</label>
              <input type="text" id="cf-company" name="company" autocomplete="organization" />
            </div>
          </div>

          <div class="field">
            <label for="cf-link">A link</label>
            <input
              type="url"
              id="cf-link"
              name="link"
              inputmode="url"
              placeholder="The posting, your site, anything relevant"
            />
          </div>

          <div class="field">
            <label for="cf-notes">Anything else</label>
            <textarea id="cf-notes" name="notes" rows="4"></textarea>
          </div>

          <div class="actions">
            <button type="submit" class="btn send">Send</button>
            <a class="inline-link skip" href="#book">Skip to booking</a>
          </div>
        </form>
      </section>

      <!-- 2. THE SCHEDULER, last. -->
      <section class="sec" id="book">
        <h2>Pick a slot</h2>
        <p class="sec-intro">
          This opens my calendar. You pick the time and get a confirmation with the
          meeting link.
        </p>
        <a class="btn book" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">
          Open the booking page
        </a>
      </section>

      <!-- 3. THE CV, unconditional. Marko's call 2026-08-15: no gate, no reveal. -->
      <section class="sec" id="cv">
        <h2>Prefer to read first?</h2>
        <p class="sec-intro">
          The CV is the same document I send with applications.
        </p>
        <a class="inline-link cv-link" href="/cv">
          <span class="metric">PDF</span>
          Marko-Stankovic-CV.pdf
        </a>
      </section>
      </div>
    </div>
  </main>

  <footer class="band">
    <div class="frame foot">
      <p>&copy; 2026 Marko Stankovic</p>
      <a class="foot-link" href="/">back to home</a>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Night register, the way projects/deploylog.astro builds it: the gutter sits on
     the band and the inner box is the full 1000px, centred, so the h1 left edge
     lands at 220 at 1440 and at 24 at 390. Tokens are global.css's; nothing here
     is a literal. The fields take the night tokens directly, because the remap
     above does not touch --color-surface. */
  .band { padding-inline: 56px; }
  .frame { max-width: 1000px; margin-inline: auto; }

  .head {
    padding-block: 8rem 3rem;
  }

  /* The mono entry line, "Send word · Book a call", same shape as the post pages
     and the DeployLog page; the band name is the way back to the home band. */
  .entry-line {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
  }
  .entry-line a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .entry-line a:hover { color: var(--color-accent); }
  .entry-line .sep { color: var(--color-border-strong); }

  /* Display face on the title and the section heads, as on the DeployLog page.
     Written here and not as a class: global.css sets h1, h2 to mono unlayered,
     which beats any utility. */
  h1 {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0 0 1.25rem;
  }
  .lede {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.625;
    max-width: 42rem;
    margin: 0;
  }

  .body {
    padding-block: 3.5rem 6rem;
  }

  /* The heads drop global.css's mono "// " prefix the same way .sec-h2 does. */
  .sec > h2::before {
    content: none;
  }
  .sec > h2 {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }
  .sec + .sec {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }
  .sec-intro {
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    max-width: 42em;
  }

  /* ── Survey ───────────────────────────────────────────────────────────── */
  .survey {
    display: grid;
    gap: 1.1rem;
    max-width: 42rem;
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  /* Labels mono on the secondary night text, like the chips. */
  .field label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-night-text-secondary);
  }
  .field input,
  .field select,
  .field textarea {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-night-text);
    background: var(--color-night-surface);
    border: 1px solid var(--color-night-border);
    border-radius: 6px;
    padding: 0.6rem 0.7rem;
    width: 100%;
    transition: border-color 0.15s ease;
  }
  .field select {
    color-scheme: dark;
  }
  .field textarea {
    resize: vertical;
    line-height: 1.6;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--color-night-text-secondary);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-aurora-cyan);
    outline: 2px solid var(--color-aurora-cyan);
    outline-offset: 2px;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-night-text-secondary);
  }

  /* Off-screen rather than display:none. A bot reading the DOM still finds it. */
  .gotcha {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  /* Buttons: outline on the night border, aurora cyan on hover, as on DeployLog. */
  .btn {
    display: inline-block;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    padding: 0.62rem 1.4rem;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover {
    color: var(--color-night-bg);
    background: var(--color-aurora-cyan);
    border-color: var(--color-aurora-cyan);
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .skip {
    font-size: 0.94rem;
  }

  .sent-note,
  .err-note {
    margin: 0 0 1.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    background: var(--color-night-surface);
    color: var(--color-text-primary);
    max-width: 42rem;
  }
  .err-note {
    border-color: var(--color-aurora-amber);
  }

  /* ── CV ───────────────────────────────────────────────────────────────── */
  .cv-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 600;
  }
  .metric {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
  }

  /* ── Footer ───────────────────────────────────────────────────────────── */
  footer {
    border-top: 1px solid var(--color-border);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-block: 2rem;
  }
  .foot p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .foot-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .foot-link:hover {
    color: var(--color-text-secondary);
  }

  @media (max-width: 720px) {
    .band { padding-inline: 24px; }
    .head {
      padding-block: 6.5rem 2.5rem;
    }
    .body {
      padding-block: 2.5rem 4rem;
    }
    .pair {
      grid-template-columns: 1fr;
    }
    .btn {
      min-height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .entry-line a, .foot-link, .field input, .field select, .field textarea { transition: none; }
  }
</style>

<script>
  // Submit without leaving the page, so the reader lands on the booking section
  // instead of Formspree's thank-you page. With JS off this listener never
  // attaches and the form posts normally, which still delivers the submission.
  const form = document.getElementById("survey-form") as HTMLFormElement | null;
  const intro = document.getElementById("survey-intro");
  const sent = document.getElementById("sent-note");
  const err = document.getElementById("err-note");
  const btn = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (btn) btn.disabled = true;
    err?.setAttribute("hidden", "");

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));

      // The intro invites you to skip a form that is no longer on the page.
      intro?.setAttribute("hidden", "");
      form.setAttribute("hidden", "");
      sent?.removeAttribute("hidden");
      document.getElementById("book")?.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch {
      // The booking link is the thing that matters and it is already on the
      // page, so a failed post must not read as a dead end.
      err?.removeAttribute("hidden");
      if (btn) btn.disabled = false;
    }
  });
</script>
