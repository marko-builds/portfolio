---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";

const allPosts = await getCollection("blog");
// Drafts are visible in `astro dev` so they can be reviewed in place, and never in a build.
// import.meta.env.DEV is false under `astro build`, which is what keeps them off the live site.
const posts = allPosts
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  // Newest first, slug tie-break reversed: the exact inverse of [slug].astro's entry
  // numbering, so the rows read 05, 04, 03, 02, 01 top-down.
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.slug.localeCompare(a.slug))
  .map((post) => {
    const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
    return {
      ...post,
      readingTime: Math.max(1, Math.ceil(words / 200)),
      slug: post.slug,
    };
  });

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const pageTitle = "Field journal | Marko Stankovic";
const pageDescription =
  "Notes from the dig: the apps, the gadgets, the engine, and the numbers each one produced.";

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SiteNav active="devlog" />

  <main>
    <div class="head-band">
      <div class="frame">
        <h1 class="hero-enter">Field journal</h1>
        <p class="hero-enter sub">
          Notes from the dig: the apps, the gadgets, the engine, and the numbers each one produced.
        </p>
        <p class="hero-enter rss">
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </div>

    <section class="list-band">
      <div class="frame">
        <h2 class="sr-only">Posts</h2>

        <div class="tag-bar" role="group" aria-label="Filter posts by tag">
          <button class="tag-btn active" data-tag="all">all</button>
          {allTags.map((tag) => <button class="tag-btn" data-tag={tag}>{tag}</button>)}
        </div>

        <div class="post-rows">
          {
            posts.map((post) => (
              <a class="post-row" href={`/field-journal/${post.slug}/`} data-tags={post.data.tags.join(",")}>
                <div class="row-meta">
                  <span class="post-date">{dateFmt(post.data.date)}</span>
                  <span class="post-time">{post.readingTime} min</span>
                </div>
                <div class="row-main">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-excerpt">{post.data.excerpt}</span>
                  <span class="post-tags">
                    {post.data.tags.map((t) => (
                      <span class="post-tag">{t}</span>
                    ))}
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        {posts.length === 0 && <p class="empty">No entries yet. The expedition has just started.</p>}
      </div>
    </section>
  </main>

  <footer>
    <div class="frame foot">
      <p>&copy; 2026 Marko Stankovic</p>
      <a class="foot-link" href="/">back to home</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .frame {
    max-width: 1000px;
    margin: 0 auto;
    padding-inline: 56px;
  }
  @media (max-width: 720px) {
    .frame { padding-inline: 28px; }
    /* The other half of call.astro's head band, missed by the first copy. */
    .head-band { padding-block: 6.5rem 2.5rem; }
  }

  /* Head band copied from call.astro, which ticket 05 built in the direction
     ticket 02 locked. The lattice stays — it is the register's head band on
     every secondary page, not dark-era decoration; the mono h1 was the dark-era
     part.

     "Value-for-value" was the first version of this comment and it was wrong in
     two ways, both of which showed up only in the rendered page. call.astro
     wraps in <main class="page">, this page wrapped in <main class="pt-14">, so
     the same 8rem cleared the 56px fixed nav twice and left 128px of air above
     the h1 against call's 72px; the wrapper is now bare, like call's. And the
     mobile override was never copied at all, so a phone kept the full desktop
     8rem. Matching declarations is not matching output. */
  .head-band {
    padding-block: 8rem 3rem;
    background:
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 0 / 100% 96px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 96px 100%;
  }
  h1 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
  }
  .sub {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 56ch;
    margin: 0;
  }
  /* Was a second .sub, so a feed link rendered at lede weight directly under
     the lede. It is metadata, which is what mono is for on this direction. */
  .rss {
    margin: 0.25rem 0 0;
  }
  /* Padded and underlined because the first version was a 22x17px hit area with
     no affordance: mono, muted, no underline, and the transition dropped when it
     stopped being a Tailwind class. At 0.78rem it reads as a label rather than a
     link unless it is given one. The block padding buys the tap target back
     (~41px) and the margin above is reduced by the same amount, so the optical
     gap under the lede is the 1rem it was. */
  .rss a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.25em;
    padding-block: 0.75rem;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .rss a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .list-band {
    border-top: 1px solid var(--color-border);
    padding-block: 56px 96px;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }
  .tag-btn {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    padding: 6px 12px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .tag-btn:hover { color: var(--color-text-primary); border-color: var(--color-text-muted); }
  /* global.css's reduced-motion block used to cancel the dark-era tag control
     this one replaced; that selector was deleted with the rest of the dead CSS
     and its live successor was never added. It has to be cancelled here rather
     than there: Astro compiles a scoped rule to an attribute selector, so a
     global .tag-btn would lose to the rule above on specificity. (The old class
     is deliberately not named: it would then be the only place in src/ that
     string survives, and the next usage grep would read it as a hit.) */
  @media (prefers-reduced-motion: reduce) {
    .tag-btn,
    .post-row { transition: none; }
  }
  .tag-btn.active {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .post-rows { border-top: 1px solid var(--color-border); }
  .post-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .post-row:hover { background: var(--color-surface); }
  .post-row.filtered-out { display: none; }
  .row-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .post-date, .post-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .row-main { display: flex; flex-direction: column; gap: 8px; }
  .post-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.35;
  }
  .post-row:hover .post-title { color: var(--color-accent); }
  .post-excerpt {
    /* 0.94rem is what the home page's own post rows run. The 62ch measure is
       kept. This comment first read "14px is not a size this direction uses
       anywhere", which .empty below and .post-title above both falsify: the
       raw-px sizes in this file were never swept, only this one was changed. */
    font-size: 0.94rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 62ch;
  }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .post-tag::before { content: "#"; color: var(--color-accent); }
  @media (max-width: 640px) {
    .post-row { grid-template-columns: 1fr; gap: 8px; }
    .row-meta { flex-direction: row; gap: 14px; }
  }

  .empty {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  footer { border-top: 1px solid var(--color-border); }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding-block: 28px;
  }
  .foot p { margin: 0; font-size: 13px; color: var(--color-text-secondary); }
  .foot-link {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .foot-link:hover { color: var(--color-text-secondary); }
</style>

<script>
  // Tag filter over the post rows
  const btns = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const rows = document.querySelectorAll<HTMLElement>(".post-row");
  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const tag = btn.dataset.tag ?? "all";
      rows.forEach((row) => {
        const rowTags = (row.dataset.tags ?? "").split(",");
        row.classList.toggle("filtered-out", tag !== "all" && !rowTags.includes(tag));
      });
    });
  });
</script>
