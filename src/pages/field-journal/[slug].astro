---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Dev only, so a draft has a real URL to review at. `astro build` sets DEV false and drops them.
  // Entry numbers count up from the first post (issue 12: the mono header line reads
  // "Field journal · Entry NN · date"). Sorted oldest first, slug as the tie-break because
  // three published posts share 2026-07-07; the number is then stable across builds.
  return posts
    .filter(p => import.meta.env.DEV || !p.data.draft)
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.slug.localeCompare(b.slug))
    .map((post, i) => ({
      params: { slug: post.slug },
      props: { post, entry: String(i + 1).padStart(2, '0') },
    }));
}

const { post, entry } = Astro.props;
const { Content } = await post.render();

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
---

<BlogPost
  title={post.data.title}
  date={post.data.date}
  excerpt={post.data.excerpt}
  tags={post.data.tags}
  readingTime={readingTime}
  entry={entry}
  ogImage={post.data.ogImage}
  draft={post.data.draft}
>
  <Content />
</BlogPost>
