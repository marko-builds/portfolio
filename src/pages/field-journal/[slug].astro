---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Dev only, so a draft has a real URL to review at. `astro build` sets DEV false and drops them.
  // Entry number (issue 12, the mono header line "Field journal · Entry NN · date"): the
  // post's position in date order of published posts, slug as the tie-break (three posts
  // share 2026-07-07). Not a permanent id: an earlier-dated post published later renumbers
  // everything after it, and the dev server counts drafts. index.astro sorts the same way,
  // reversed, so the list reads 05, 04, 03, 02, 01 top-down.
  return posts
    .filter(p => import.meta.env.DEV || !p.data.draft)
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.slug.localeCompare(b.slug))
    .map((post, i) => ({
      params: { slug: post.slug },
      props: { post, entry: String(i + 1).padStart(2, '0') },
    }));
}

const { post, entry } = Astro.props;
const { Content } = await post.render();

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
---

<BlogPost
  title={post.data.title}
  date={post.data.date}
  excerpt={post.data.excerpt}
  tags={post.data.tags}
  readingTime={readingTime}
  entry={entry}
  ogImage={post.data.ogImage}
  draft={post.data.draft}
>
  <Content />
</BlogPost>
