---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Dev only, so a draft has a real URL to review at. `astro build` sets DEV false and drops them.
  // The entry number ("Field journal · Entry NN · date") is the post's own `entry` field,
  // pinned at publish by scripts/publish-devlog.sh (issue 18). Until 2026-08-23 it was the
  // post's position in date order, which renumbered every later entry whenever an
  // earlier-dated post went live. A post with no `entry` (every draft) renders "··".
  return posts
    .filter(p => import.meta.env.DEV || !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
---

<BlogPost
  title={post.data.title}
  date={post.data.date}
  excerpt={post.data.excerpt}
  tags={post.data.tags}
  readingTime={readingTime}
  entry={post.data.entry}
  opener={post.data.opener}
  ogImage={post.data.ogImage}
  draft={post.data.draft}
>
  <Content />
</BlogPost>
