---
// PROTOTYPE, throwaway. issues/map-site-v3/03-register-prototype.md.
// The light body both register variants share, on the ticket 09 home order:
// (hero is the variant's own) then proof, products, lab notes, contact.
// Copy: v2 wording where a section survives (proof, products, contact); anything
// new carries [PLACEHOLDER] and is ticket 11's to write. Section labels are
// numbered (01.) as a stand-in for the retired `//` prefix; ticket 04/05 own the
// real treatment. h2 reads --font-display (ticket 04's token), falling back to Geist.
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// v2 proof cards, verbatim (index.astro, read off the repos 2026-08-15).
const proof = [
  {
    name: "skill-vibe-test",
    what: "Does an agent skill still steer the model after ten turns? It runs the skill live in one growing context and an LLM judge scores every probe.",
    metric: "4 probes over 10 turns",
    date: "Jul 2026",
    href: "https://github.com/marko-builds/skill-vibe-test",
  },
  {
    name: "adpreflight",
    what: "Checks a hand-coded HTML5 playable ad against network rule packs before you submit it, so the rejection lands on your machine instead of in an email three days later.",
    metric: "2 network rule packs",
    date: "Aug 2026",
    href: "https://github.com/marko-builds/adpreflight",
  },
  {
    name: "duskpaper",
    what: "Renders animated wallpapers on your machine, at your resolution, from your seed. Every loop is seamless by construction, not by luck.",
    metric: "6 scene engines",
    date: "Jul 2026",
    href: "https://github.com/marko-builds/duskpaper",
  },
];

const products = [
  { name: "deploylog", what: "Release notes from real git history.", href: "/projects/deploylog/", status: "launching" },
  { name: "habitagram", what: "Habit tracking as a journey.", href: null, status: "near launch" },
  { name: "studio", what: "The generative media engine behind both.", href: "/devlog", status: "internal" },
];

const identity = {
  location: "Belgrade, Serbia",
  languages: "Serbian (native), English",
  email: "contact@markostankovic.org",
  github: "https://github.com/marko-builds",
  linkedin: "https://www.linkedin.com/in/marko-builds/",
  rss: "/rss.xml",
  call: "/call",
};

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<main id="main">
  <section class="sec light" id="products">
    <div class="sec-head">
      <span class="num">01.</span>
      <h2>Products</h2>
    </div>
    <ul class="product-rows">
      {products.map((p) => (
        <li class="product-row">
          {p.href ? <a href={p.href}>{p.name}</a> : <span class="product-name">{p.name}</span>}
          <span class="product-what">{p.what}</span>
          <span class="product-status">{p.status}</span>
        </li>
      ))}
    </ul>
  </section>

  {recentPosts.length > 0 && (
    <section class="sec night" id="lab-notes">
      <div class="sec-head">
        <span class="num">02.</span>
        <h2>Lab notes</h2>
        <a class="all-link" href="/devlog">All notes</a>
      </div>
      <ul class="post-rows">
        {recentPosts.map((p) => (
          <li class="post-row">
            <a class="post-title" href={`/devlog/${p.slug}/`}>{p.data.title}</a>
            <p class="post-excerpt">{p.data.excerpt}</p>
            <span class="post-date">{fmt(p.data.date)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="sec light" id="work">
    <div class="sec-head">
      <span class="num">03.</span>
      <h2>Tools</h2>
    </div>
    <p class="sec-intro">Open source. Every one has a repo you can read and a check you can run.</p>
    <ul class="proof-grid">
      {proof.map((p) => (
        <li class="proof-card">
          <a class="proof-title" href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a>
          <p class="proof-what">{p.what}</p>
          <p class="proof-meta">
            <span class="metric">{p.metric}</span>
            <span class="sep">·</span>
            <span>{p.date}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

</main>

<div class="night tail">
  <section class="sec" id="contact">
    <div class="sec-head">
      <span class="num">04.</span>
      <h2>Contact</h2>
    </div>
    <div class="contact">
      <dl class="facts">
        <div><dt>Based</dt><dd>{identity.location}</dd></div>
        <div><dt>Languages</dt><dd>{identity.languages}</dd></div>
      </dl>
      <ul class="links">
        <li><a href={`mailto:${identity.email}`}>Email</a></li>
        <li><a href={identity.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={identity.rss}>RSS</a></li>
        <li><a href={identity.call} class="call-link">Book a call</a></li>
      </ul>
    </div>
  </section>
<footer class="foot-wrap">
  <div class="foot">
    <p>&copy; 2026 Marko Stankovic</p>
    <p class="foot-meta">AI engineer · Belgrade</p>
  </div>
</footer>
</div>

<style>
  /* Alternating bands, Marko 2026-08-22: each section is full-bleed and carries its
     own register; the inner grid is the 1000px column. */
  .sec {
    padding: 3rem 56px 4rem;
    margin: 0;
  }
  .sec > * { max-width: 1000px; margin-left: auto; margin-right: auto; }
  .light { background: var(--color-bg); color: var(--color-text-primary); }
  .night {
    background-color: var(--color-night-bg);
    color: var(--color-night-text);
    position: relative;
    isolation: isolate;
  }
  /* 2D neon lattice for the dark bands, Marko 2026-08-23: the devlog header's graph
     paper (global.css --color-grid) in the ramp, magenta left to cyan right, fixed
     72px cells so nothing scales with band height, with a glow along the bottom.
     Stand-in for ticket 06's scroll-following graphics. */
  .tail::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--aurora-0), var(--aurora-1) 45%, var(--aurora-2));
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 72px);
    mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 72px);
    /* Top layer composites onto the union below it: fade INTERSECT (v lines ADD h lines). */
    -webkit-mask-composite: source-in, source-over, source-over;
    mask-composite: intersect, add, add;
    opacity: 0.55;
  }
  .tail::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    bottom: 0;
    height: 260px;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(700px 160px at 18% 100%, color-mix(in srgb, var(--aurora-0) 40%, transparent), transparent 70%),
      radial-gradient(700px 160px at 82% 100%, color-mix(in srgb, var(--aurora-2) 35%, transparent), transparent 70%);
    filter: blur(2px);
  }
  .night > * { position: relative; z-index: 1; }
  .night .sec-head h2, .night .post-title, .night .call-link, .night .facts dd { color: var(--color-night-text); }
  .night .num { color: var(--color-aurora-cyan); }
  .night .sec-intro, .night .post-excerpt, .night .all-link, .night .links a { color: var(--color-night-text-secondary); }
  .night .post-date, .night .facts dt { color: var(--color-night-text-secondary); }
  .night .post-row { border-bottom-color: var(--color-night-border); }
  .night .post-title:hover, .night .all-link:hover, .night .links a:hover { color: var(--color-aurora-cyan); }
  .night .links a:hover { border-bottom-color: var(--color-aurora-cyan); }
  @media (max-width: 720px) {
    .sec { padding: 2.25rem 24px 3rem; }
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }
  .sec-head h2 {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .sec-head h2::before { content: none; }
  .sec-intro {
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
  }
  .all-link {
    margin-left: auto;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .all-link:hover { color: var(--color-accent); }

  .proof-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .proof-card {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
    background: var(--color-surface);
    box-shadow: 0 1px 2px var(--color-grid), 0 8px 24px -16px var(--color-grid);
    position: relative;
    overflow: hidden;
  }
  /* The aurora ramp as a hairline on the card top edge: the one accent the light
     body takes from the hero, in both variants. */
  .proof-card::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: var(--aurora-ramp);
    opacity: 0.8;
  }
  .proof-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .proof-title:hover { color: var(--color-accent); }
  .proof-what {
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0.9rem;
    font-size: 0.94rem;
  }
  .proof-meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .metric {
    font-family: var(--font-mono);
    font-size: 0.85em;
    white-space: nowrap;
  }
  .sep { color: var(--color-text-muted); }

  .product-rows, .post-rows, .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .product-rows { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .product-row {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    flex-wrap: wrap;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .product-row a, .product-name {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .product-row a:hover { color: var(--color-accent); }
  .product-what { color: var(--color-text-secondary); font-size: 0.94rem; }
  .product-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: auto;
    white-space: nowrap;
  }

  .post-rows { display: grid; gap: 1.5rem; margin-top: 1rem; }
  .post-row { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .post-row:last-child { padding-bottom: 0; border-bottom: 0; }
  .post-title {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
    display: inline-block;
  }
  .post-title:hover { color: var(--color-accent); }
  .post-excerpt { color: var(--color-text-secondary); margin: 0.4rem 0 0.5rem; font-size: 0.94rem; }
  .post-date { color: var(--color-text-muted); font-size: 0.82rem; }

  .contact {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .facts { margin: 0; display: grid; gap: 0.45rem; }
  .facts dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .facts dd { margin: 0; color: var(--color-text-secondary); font-size: 0.92rem; }
  .links { display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: baseline; }
  .links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .links a:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  .call-link { font-weight: 600; color: var(--color-text-primary); }

  .foot-wrap { padding-inline: 56px; }
  .tail .foot p { color: var(--color-night-text-secondary); }
  .foot {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .foot p { margin: 0; font-size: 0.85rem; color: var(--color-text-secondary); }
  @media (max-width: 720px) {
    .foot-wrap { padding-inline: 24px; }
    .foot { padding: 0 0 1.5rem; }
  }
</style>
