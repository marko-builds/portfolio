---
// PROTOTYPE, throwaway: ticket 04, one route per display-face candidate on the locked
// register C (hero h1 + the 01. section h2s), Geist body held constant. The face is a NEW
// token, --font-display, set on :root here; --font-sans and --font-mono are untouched.
// issues/map-site-v3/04-display-typeface.md. Delete after the pick.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeroC from "../_HeroC.astro";
import Body from "../_Body.astro";
import FaceSwitcher from "../_FaceSwitcher.astro";
import { faces } from "../_faces";

export function getStaticPaths() {
  return faces.map((f) => ({ params: { face: f.slug }, props: { f } }));
}
const { f } = Astro.props;

const fontFace = f.family
  ? `@font-face{font-family:"${f.family}";font-style:normal;font-weight:${f.weight};font-display:swap;src:url(/fonts/${f.file}) format("woff2")}`
  : "";
const root = f.family
  ? `:root{--font-display:"${f.family}",var(--font-sans)}`
  : "";
const tune = `.night h1{letter-spacing:${f.tracking};font-size:clamp(${(1.9 * f.scale).toFixed(2)}rem,${(4.2 * f.scale).toFixed(2)}vw,${(2.9 * f.scale).toFixed(2)}rem)}`;
const head = `<meta name="robots" content="noindex">` +
  (f.file ? `<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/${f.file}">` : "") +
  `<style>${fontFace}${root}${tune}</style>`;
---

<BaseLayout title={`Proto 04: ${f.label}`} description="Prototype, not indexed.">
  <Fragment slot="head" set:html={head} />
  <HeroC stripPlaceholder />
  <Body />
  <FaceSwitcher current={f.slug} />
</BaseLayout>
