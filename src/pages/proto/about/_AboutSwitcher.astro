---
// PROTOTYPE chrome, not part of the design under review. Three routes, so the
// switcher is three links (the same shape as ../_Switcher.astro).
interface Props { current: "a" | "b" | "c" }
const { current } = Astro.props;
const variants = [
  { key: "a", label: "story first, line strip", href: "/proto/about/" },
  { key: "b", label: "strip opener", href: "/proto/about/b/" },
  { key: "c", label: "two column, card strip", href: "/proto/about/c/" },
];
---

<nav class="sw" aria-label="Prototype variants">
  <span class="tag">proto 12</span>
  {variants.map((v) => (
    <a href={v.href} class:list={[{ on: v.key === current }]} aria-current={v.key === current ? "page" : undefined}>
      <b>{v.key.toUpperCase()}</b> {v.label}
    </a>
  ))}
</nav>

<style>
  .sw {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: var(--color-bg);
    box-shadow: 0 8px 24px -8px var(--color-backdrop);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .tag { padding: 4px 8px; color: var(--color-aurora-amber); letter-spacing: 0.08em; text-transform: uppercase; }
  .sw a { color: var(--color-bg); text-decoration: none; padding: 6px 12px; border-radius: 999px; opacity: 0.7; }
  .sw a.on { background: var(--color-accent); opacity: 1; }
  .sw b { font-weight: 700; }
  @media (max-width: 560px) {
    .sw a { padding: 6px 8px; }
    .sw a:not(.on) { font-size: 0; }
    .sw a:not(.on) b { font-size: 12px; }
  }
</style>
