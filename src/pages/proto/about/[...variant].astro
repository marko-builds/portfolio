---
// PROTOTYPE, throwaway. issues/map-site-v3/12-about-page.md.
// Three structurally different /about pages on the locked register (ticket 03's bands,
// 04's display face, 05's nav mark), switchable from the pill:
//   a  /proto/about/    story first, then the dates as a Lazarev line strip on a night
//                       band, then what he is building now, then how to follow (night
//                       tail with the lattice);
//   b  /proto/about/b/  the strip opens the page inside the night nav band, then story,
//                       now, follow on alternating bands;
//   c  /proto/about/c/  two column story (portrait and facts in a sticky left column),
//                       then the dates as tall card tiles, then now, then follow.
// No hero, no shader: inner routes get no aurora (ticket 06 owns any inner strip). The
// only script is the ~600 B drag helper below, unmarked, inside the general budget. It
// also reads ?scroll=N for the captures. Delete the whole directory at close-out.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NavNight from "./_NavNight.astro";
import Strip from "./_Strip.astro";
import Switcher from "./_AboutSwitcher.astro";
import { identity, story, now, follow } from "./_dates";

export function getStaticPaths() {
  return [{ params: { variant: undefined } }, { params: { variant: "b" } }, { params: { variant: "c" } }];
}
const v = (Astro.params.variant ?? "a") as "a" | "b" | "c";
const titles = { a: "story first, line strip", b: "strip opener", c: "two column, card strip" };
---

<BaseLayout title={`Proto 12 ${v.toUpperCase()}: about, ${titles[v]}`} description="Prototype, not indexed.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <NavNight />

  {v === "b" && (
    <section class="sec night opener" id="dates">
      <p class="kicker">{identity.name}</p>
      <h1>[PLACEHOLDER] Five years, one strip.</h1>
      <p class="sec-intro">[PLACEHOLDER] The who and the when, left to right. The story is underneath.</p>
      <Strip treatment="line" tone="night" />
    </section>
  )}

  <main id="main">
    <section class:list={["sec", "light", { twocol: v === "c" }]} id="story">
      {v === "c" && (
        <aside class="side">
          <img class="portrait" src="/portrait.webp" alt={identity.name} width="480" height="480" />
          <dl class="facts">
            <div><dt>Based</dt><dd>{identity.location}</dd></div>
            <div><dt>Languages</dt><dd>{identity.languages}</dd></div>
            <div><dt>Since</dt><dd>2021, Unity and C#</dd></div>
          </dl>
        </aside>
      )}
      <div class="col">
        <div class="sec-head">
          <span class="num">01.</span>
          <h2>Story</h2>
        </div>
        {v !== "b" && <h1>[PLACEHOLDER] A builder in Belgrade, shipping real things with AI agents.</h1>}
        {story.map((p) => <p class="story">{p}</p>)}
      </div>
    </section>

    {v === "a" && (
      <section class="sec night" id="dates">
        <div class="sec-head">
          <span class="num">02.</span>
          <h2>Dates</h2>
        </div>
        <p class="sec-intro">[PLACEHOLDER] The who and the when, left to right. Drag, scroll, or use the arrow keys.</p>
        <Strip treatment="line" tone="night" />
      </section>
    )}

    {v === "c" && (
      <section class="sec night" id="dates">
        <div class="sec-head">
          <span class="num">02.</span>
          <h2>Dates</h2>
        </div>
        <p class="sec-intro">[PLACEHOLDER] The who and the when, left to right. Drag, scroll, or use the arrow keys.</p>
        <Strip treatment="cards" tone="night" />
      </section>
    )}

    <section class:list={["sec", v === "b" ? "night" : "light"]} id="now">
      <div class="sec-head">
        <span class="num">{v === "b" ? "02." : "03."}</span>
        <h2>Building now</h2>
      </div>
      <p class="sec-intro">{now.intro}</p>
      <ul class="product-rows">
        {now.rows.map((p) => (
          <li class="product-row">
            {p.href ? <a href={p.href}>{p.name}</a> : <span class="product-name">{p.name}</span>}
            <span class="product-what">{p.what}</span>
            <span class="product-status">{p.status}</span>
          </li>
        ))}
      </ul>
    </section>

    {v === "b" && (
      <section class="sec light" id="follow">
        <div class="sec-head">
          <span class="num">03.</span>
          <h2>Follow</h2>
        </div>
        <p class="sec-intro">{follow.intro}</p>
        <ul class="follow">
          <li><a href={identity.rss}><b>RSS</b><span>every lab note, in your reader</span></a></li>
          <li><a href={identity.github} target="_blank" rel="noopener noreferrer"><b>GitHub</b><span>the tools, the apps, the commits</span></a></li>
        </ul>
      </section>
    )}
  </main>

  <div class="night tail">
    {v !== "b" && (
      <section class="sec" id="follow">
        <div class="sec-head">
          <span class="num">04.</span>
          <h2>Follow</h2>
        </div>
        <p class="sec-intro">{follow.intro}</p>
        <ul class="follow">
          <li><a href={identity.rss}><b>RSS</b><span>every lab note, in your reader</span></a></li>
          <li><a href={identity.github} target="_blank" rel="noopener noreferrer"><b>GitHub</b><span>the tools, the apps, the commits</span></a></li>
        </ul>
        <p class="aside-links">Or <a href={`mailto:${identity.email}`}>email</a> and <a href={identity.call}>book a call</a>.</p>
      </section>
    )}
    <footer class="foot-wrap">
      <div class="foot">
        <p>&copy; 2026 Marko Stankovic</p>
        <p class="foot-meta">AI engineer · Belgrade</p>
      </div>
    </footer>
  </div>

  <Switcher current={v} />
</BaseLayout>

<script is:inline>
(function(){var q=new URLSearchParams(location.search).get("scroll");document.querySelectorAll("[data-rail]").forEach(function(r){if(q)r.scrollLeft=+q;var on=false,mv=false,x=0,s=0;r.addEventListener("pointerdown",function(e){if(e.pointerType!=="mouse"||e.button)return;on=true;mv=false;x=e.clientX;s=r.scrollLeft;r.setPointerCapture(e.pointerId)});r.addEventListener("pointermove",function(e){if(!on)return;var d=e.clientX-x;if(!mv&&Math.abs(d)<4)return;if(!mv){mv=true;r.classList.add("drag")}r.scrollLeft=s-d});function up(){if(!on)return;on=false;r.classList.remove("drag")}r.addEventListener("pointerup",up);r.addEventListener("pointercancel",up);r.addEventListener("click",function(e){if(mv){e.preventDefault();mv=false}},true)})})();
</script>

<style>
  /* The band system from _Body.astro (ticket 03's lock), copied rather than shared so
     each variant can throw the layout away. */
  .sec { padding: 3rem 56px 4rem; margin: 0; }
  .sec > * { max-width: 1000px; margin-left: auto; margin-right: auto; }
  .light { background: var(--color-bg); color: var(--color-text-primary); }
  .night {
    background-color: var(--color-night-bg);
    color: var(--color-night-text);
    position: relative;
    isolation: isolate;
  }
  .night > * { position: relative; z-index: 1; }
  .tail { position: relative; isolation: isolate; }
  .tail::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--aurora-0), var(--aurora-1) 45%, var(--aurora-2));
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 72px);
    mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 72px);
    -webkit-mask-composite: source-in, source-over, source-over;
    mask-composite: intersect, add, add;
    opacity: 0.55;
  }
  .tail::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 260px;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(700px 160px at 18% 100%, color-mix(in srgb, var(--aurora-0) 40%, transparent), transparent 70%),
      radial-gradient(700px 160px at 82% 100%, color-mix(in srgb, var(--aurora-2) 35%, transparent), transparent 70%);
    filter: blur(2px);
  }
  .tail > * { position: relative; z-index: 1; }
  .night .sec-head h2, .night h1, .night .product-row a, .night .product-name { color: var(--color-night-text); }
  .night .num { color: var(--color-aurora-cyan); }
  .night .sec-intro, .night .product-what, .night .aside-links, .night .follow span { color: var(--color-night-text-secondary); }
  .night .product-status { color: var(--color-night-text-secondary); }
  .night .product-row { border-bottom-color: var(--color-night-border); }
  .night .product-row a:hover, .night .aside-links a:hover { color: var(--color-aurora-cyan); }
  .night .aside-links a { color: var(--color-night-text); }
  .night .follow a { border-color: var(--color-night-border); background: var(--color-night-surface); color: var(--color-night-text); }
  .night .follow a:hover { border-color: var(--color-aurora-cyan); }
  .night .follow b { color: var(--color-aurora-cyan); }

  .sec-head { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.25rem; }
  .num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-accent); letter-spacing: 0.04em; }
  .sec-head h2 {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .sec-head h2::before { content: none; }
  .sec-intro { color: var(--color-text-secondary); margin: 0 0 1.5rem; max-width: 36em; }

  h1 {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 1rem 0 1.5rem;
    max-width: 18em;
    color: var(--color-text-primary);
  }
  .story {
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 36em;
    margin: 0 0 1.1rem;
    color: var(--color-text-primary);
  }
  .story:last-child { margin-bottom: 0; }

  /* B: the strip opens the page inside the nav's night band. */
  .opener { padding-top: 2.5rem; padding-bottom: 3rem; }
  .kicker { margin: 0 0 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--color-aurora-cyan); }
  .opener h1 { margin-top: 0; margin-bottom: 0.75rem; }
  .opener .sec-intro { margin-bottom: 0.5rem; }

  /* C: two column story, the portrait and facts stick while the story scrolls. */
  .twocol {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 3.5rem;
    padding-inline: max(56px, calc((100% - 1000px) / 2));
  }
  .twocol > * { max-width: none; margin: 0; }
  .twocol .col h1 { margin-top: 0.5rem; }
  .side { position: sticky; top: 2rem; align-self: start; display: grid; gap: 1.25rem; }
  .portrait {
    width: 240px; height: 240px;
    border-radius: 12px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--color-border-strong);
  }
  .facts { margin: 0; display: grid; gap: 0.5rem; }
  .facts dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .facts dd { margin: 0; color: var(--color-text-secondary); font-size: 0.92rem; }

  .product-rows { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.6rem; }
  .product-row { display: flex; gap: 0.75rem; align-items: baseline; flex-wrap: wrap; padding-bottom: 0.6rem; border-bottom: 1px solid var(--color-border); }
  .product-row a, .product-name { color: var(--color-text-primary); text-decoration: none; font-weight: 600; }
  .product-row a:hover { color: var(--color-accent); }
  .product-what { color: var(--color-text-secondary); font-size: 0.94rem; }
  .product-status { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); margin-left: auto; white-space: nowrap; }

  .follow { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; max-width: 640px; }
  .follow a {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text-primary);
  }
  .follow a:hover { border-color: var(--color-accent); }
  .follow b { font-family: var(--font-mono); font-size: 1.1rem; color: var(--color-accent); }
  .follow span { font-size: 0.9rem; color: var(--color-text-secondary); }
  .aside-links { margin: 1.5rem 0 0; font-size: 0.9rem; }
  .aside-links a { color: inherit; }

  .foot-wrap { padding-inline: 56px; }
  .tail .foot p { color: var(--color-night-text-secondary); }
  .foot { max-width: 1000px; margin: 0 auto; padding: 0 0 1.75rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .foot p { margin: 0; font-size: 0.85rem; }
  .tail > .foot-wrap:first-child { padding-top: 2.5rem; }

  @media (max-width: 720px) {
    .sec { padding: 2.25rem 24px 3rem; }
    .twocol { grid-template-columns: 1fr; gap: 1.5rem; padding-inline: 24px; }
    .side { position: static; grid-template-columns: 112px 1fr; align-items: center; }
    .portrait { width: 112px; height: 112px; }
    .foot-wrap { padding-inline: 24px; }
    .foot { padding: 0 0 1.5rem; }
  }
</style>
