---
// PROTOTYPE, throwaway. issues/map-site-v3/12-about-page.md.
// The dates strip: a full-bleed rail that scroll-snaps (CSS only), with pointer drag
// for mouse users from the ~600 B inline script on the route. Two treatments:
//   line   Lazarev's shape, tiles sit ON a horizontal rule, a dot marks the date on
//          the line, date and label hang below it;
//   cards  tall 4:5 tiles, the year as the big figure inside, label at the tile foot,
//          no line.
// A date with no photo gets a typographic tile (year in the display face on a night
// tile), so the inventory's gaps do not read as holes. The rail is focusable and the
// arrow keys scroll it natively; the scrollbar is hidden; smooth scroll only when the
// visitor has not asked for reduced motion; drag turns snap off until release.
import { dates } from "./_dates";
interface Props { treatment: "line" | "cards"; tone: "night" | "light"; label?: string }
const { treatment, tone, label = "Dates, scroll sideways" } = Astro.props;
---

<div class:list={["rail", `t-${treatment}`, tone]} data-rail tabindex="0" aria-label={label}>
  <ol class="cards">
    {dates.map((d) => {
      const Tag = d.href ? "a" : "div";
      return (
        <li class="card">
          <Tag class="card-in" href={d.href} target={d.href?.startsWith("http") ? "_blank" : undefined} rel={d.href?.startsWith("http") ? "noopener noreferrer" : undefined}>
            {d.photo ? (
              <img class="tile photo" src={d.photo} alt="" width="480" height="480" loading="lazy" draggable="false" />
            ) : (
              <span class="tile type" aria-hidden="true">
                <b>{d.year}</b>
                {d.month && <i>{d.month}</i>}
              </span>
            )}
            <span class="dot" aria-hidden="true"></span>
            <span class="when">{d.when}</span>
            <span class="what">{d.label}</span>
            <span class="org">{d.org}</span>
          </Tag>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .rail {
    --card: 232px;
    --tile: 144px;
    --gutter: max(56px, calc((100% - 1000px) / 2));
    position: relative;
    max-width: none;
    margin: 1.5rem -56px 0;
    padding: 0.5rem var(--gutter) 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: no-preference) { .rail { scroll-behavior: smooth; } }
  @media (hover: hover) and (pointer: fine) { .rail { cursor: grab; } }
  .rail.drag {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }
  .rail.drag .card-in { pointer-events: none; }
  .rail:focus-visible { outline: 2px solid var(--color-aurora-cyan); outline-offset: -2px; border-radius: 4px; }
  .light.rail:focus-visible { outline-color: var(--color-accent); }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    width: max-content;
    position: relative;
  }
  .card { flex: none; width: var(--card); scroll-snap-align: start; }
  .card-in {
    display: grid;
    grid-template-rows: var(--tile) auto auto auto auto;
    align-content: start;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
  }
  .tile {
    width: var(--tile);
    height: var(--tile);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    background: var(--color-night-bg);
    border: 1px solid var(--color-night-border);
    position: relative;
    overflow: hidden;
  }
  .photo { object-fit: cover; display: block; }
  .type b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-aurora-cyan);
  }
  .type i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-night-text-secondary);
    margin-top: 0.35rem;
  }
  /* The ramp as a 2px hairline along the tile top, the one accent the light body takes
     from the hero (same move as the proof cards). */
  .type::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: var(--aurora-ramp);
    opacity: 0.8;
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    margin-top: 0.9rem;
  }
  .what { font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  .org { font-size: 0.85rem; }

  /* Tones. */
  .night { color: var(--color-night-text); }
  .night .when { color: var(--color-aurora-cyan); }
  .night .org { color: var(--color-night-text-secondary); }
  .night .tile { border-color: var(--color-night-border); background: var(--color-night-surface); }
  .light { color: var(--color-text-primary); }
  .light .when { color: var(--color-accent); }
  .light .org { color: var(--color-text-secondary); }
  .light .photo { border: 1px solid var(--color-border-strong); }
  .card-in:hover .what { text-decoration: underline; text-underline-offset: 3px; }

  /* Line treatment: a rule at the tile's foot across the whole strip, a dot per date. */
  .t-line .cards::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--gutter)); right: calc(-1 * var(--gutter));
    top: calc(var(--tile) + 0.5rem);
    height: 1px;
    background: var(--color-night-border);
  }
  .light.t-line .cards::before { background: var(--color-border-strong); }
  .t-line .card-in { grid-template-rows: var(--tile) 1rem auto auto auto; }
  .t-line .dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--color-aurora-cyan);
    margin: 0.25rem 0 0 calc(var(--tile) / 2 - 4px);
    box-shadow: 0 0 0 4px var(--color-night-bg);
  }
  .light.t-line .dot { background: var(--color-accent); box-shadow: 0 0 0 4px var(--color-bg); }
  .t-line .when { margin-top: 0.4rem; }
  .t-line .tile { border-radius: 10px 10px 0 0; border-bottom: 0; }

  /* Cards treatment: one tall tile per date, the figures live inside it. */
  .t-cards .dot { display: none; }
  .t-cards { --card: 200px; --tile: 200px; }
  .t-cards .tile { height: calc(var(--tile) * 1.25); width: 100%; border-radius: 12px; justify-content: flex-end; align-items: flex-start; padding: 1rem; }
  .t-cards .type b { font-size: 2.6rem; }
  .t-cards .type i { margin-top: 0.2rem; }
  .t-cards .card-in { grid-template-rows: calc(var(--tile) * 1.25) auto auto auto; }
  .t-cards .when { margin-top: 0.75rem; }
  .t-cards .photo { height: calc(var(--tile) * 1.25); }

  @media (max-width: 720px) {
    .rail { --gutter: 24px; --card: 196px; --tile: 120px; margin-inline: -24px; }
    .t-cards { --card: 172px; --tile: 172px; }
    .type b { font-size: 1.7rem; }
    .t-cards .type b { font-size: 2.1rem; }
    .cards { gap: 1rem; }
  }
</style>
