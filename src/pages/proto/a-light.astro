---
// PROTOTYPE A, throwaway: light page, aurora ramp as accents and a thin strip only.
// issues/map-site-v3/03-register-prototype.md. Delete after the pick.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Body from "./_Body.astro";
import Switcher from "./_Switcher.astro";
import { hero, receipts } from "./_hero";
import { getCollection } from "astro:content";

const postCount = (await getCollection("blog")).filter((p) => import.meta.env.DEV || !p.data.draft).length;
const rows = receipts(postCount);
---

<BaseLayout title="Proto A: light with accents" description="Prototype, not indexed.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

  <div class="strip" aria-hidden="true"></div>

  <header class="nav">
    <nav aria-label="Site">
      <a class="mark" href="/">MS</a>
      <ul>
        <li><a href="#products">Products</a></li>
        <li><a href="#lab-notes">Lab notes</a></li>
        <li><a href="#work">Tools</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-in">
      <img class="photo" src={hero.photo} alt={hero.name} width="480" height="480" />
      <div class="hero-text">
        <p class="kicker">{hero.name}</p>
        <h1>{hero.line}</h1>
        <p class="sub">{hero.sub}</p>
        <div class="ctas">
          {hero.ctas.map((c) => (
            <a href={c.href} class:list={["cta", { primary: c.primary }]}>{c.label}</a>
          ))}
        </div>
      </div>
    </div>
    <ul class="receipts">
      {rows.map((r) => (
        <li>
          <a href={r.href}>
            <span class="n">{r.n}</span>
            <span class="l">{r.label}</span>
            <span class="note">{r.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Body />
  <Switcher current="A" />
</BaseLayout>

<style>
  /* The only aurora on this page: a 4px ramp strip along the top. */
  .strip {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--aurora-ramp);
    z-index: 10000;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-veil);
    backdrop-filter: blur(3px);
  }
  nav {
    max-width: 1000px;
    margin: 0 auto;
    padding-inline: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mark {
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
    text-decoration: none;
  }
  nav ul { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; }
  nav ul a { font-size: 0.9rem; color: var(--color-text-secondary); text-decoration: none; }
  nav ul a:hover { color: var(--color-text-primary); }

  .hero {
    max-width: 1000px;
    margin: 0 auto;
    padding: 5rem 56px 0;
  }
  .hero-in {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  .photo {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border-strong);
    /* The ramp as a ring behind the photo: accent, not surface. */
    box-shadow: 0 0 0 4px var(--color-bg), 0 0 0 6px var(--aurora-2);
  }
  .kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--color-text-primary);
    max-width: 22em;
  }
  .sub {
    margin: 1rem 0 0;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 36em;
  }
  .ctas { display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .cta {
    display: inline-block;
    padding: 0.65rem 1.15rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    background: var(--color-surface);
  }
  .cta.primary {
    background: var(--color-text-primary);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
  }
  .cta:hover { border-color: var(--color-accent); }

  .receipts {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .receipts li + li { border-left: 1px solid var(--color-border); }
  .receipts a {
    display: grid;
    gap: 0.15rem;
    padding: 1.25rem 1.25rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }
  .receipts .n {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    background: var(--aurora-ramp);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .receipts .l { font-size: 0.95rem; color: var(--color-text-primary); }
  .receipts .note { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); }

  @media (max-width: 720px) {
    nav { padding-inline: 24px; }
    .hero { padding: 3rem 24px 0; }
    .hero-in { grid-template-columns: 1fr; gap: 1.5rem; }
    .photo { width: 120px; height: 120px; }
    .receipts { grid-template-columns: 1fr; }
    .receipts li + li { border-left: 0; border-top: 1px solid var(--color-border); }
    .receipts a { padding: 1rem 0; grid-template-columns: 4rem 1fr; grid-template-rows: auto auto; }
    .receipts .n { grid-row: 1 / span 2; font-size: 1.6rem; align-self: center; }
  }
</style>
