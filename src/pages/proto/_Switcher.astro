---
// PROTOTYPE chrome, not part of the design under review. Two routes, so the
// switcher is two links rather than a ?variant= param.
interface Props { current: "A" | "C" }
const { current } = Astro.props;
const variants = [
  { key: "A", label: "light + accents", href: "/proto/a-light/" },
  { key: "C", label: "night window hybrid", href: "/proto/c-hybrid/" },
];
---

<nav class="sw" aria-label="Prototype variants">
  <span class="tag">proto</span>
  {variants.map((v) => (
    <a href={v.href} class:list={[{ on: v.key === current }]} aria-current={v.key === current ? "page" : undefined}>
      <b>{v.key}</b> {v.label}
    </a>
  ))}
</nav>

<style>
  .sw {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: var(--color-bg);
    box-shadow: 0 8px 24px -8px var(--color-backdrop);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .tag {
    padding: 4px 8px;
    color: var(--color-aurora-amber);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sw a {
    color: var(--color-bg);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 999px;
    opacity: 0.7;
  }
  .sw a.on { background: var(--color-accent); opacity: 1; }
  .sw b { font-weight: 700; }
  @media (max-width: 480px) {
    .sw a { padding: 6px 8px; }
    .sw a:not(.on) { font-size: 0; }
    .sw a:not(.on) b { font-size: 12px; }
  }
</style>
