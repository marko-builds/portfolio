---
// PROTOTYPE, throwaway: ticket 05's OG-card mock, 1200x630, one per mark. The card's copy,
// grid and crosses follow play/og_card_portfolio.html (the v3 card's source); only the top
// row changes: the mark plus the wordmark replace the `> MarkoStankovic(AI Engineer);` line.
// Capture at --window-size=1200,630. Not a route the site links; delete after the pick.
import { marks, inlineSvg } from "../_marks";

export function getStaticPaths() {
  return marks.map((m) => ({ params: { mark: m.slug }, props: { m } }));
}
const { m } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{`OG mock: ${m.label}`}</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/space-grotesk-600.woff2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@600;700&family=JetBrains+Mono:wght@500&display=swap" />
    <style is:global>
      @font-face { font-family: "Space Grotesk"; font-weight: 600; font-display: swap; src: url(/fonts/space-grotesk-600.woff2) format("woff2"); }
      html, body { margin: 0; background: #0B0E15; }
      .card {
        position: relative; width: 1200px; height: 630px; overflow: hidden; background: #0B0E15; color: #E4E9EC;
        background-image: linear-gradient(#101820 1px, transparent 1px), linear-gradient(90deg, #101820 1px, transparent 1px);
        background-size: 150px 150px; background-position: -25px -25px;
        font-family: "Geist", system-ui, sans-serif;
      }
      .card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 6px; background: linear-gradient(90deg, #962DB4, #5A6ECD, #23C8C8, #1EEB82, #19B450); }
      .cross { position: absolute; width: 14px; height: 14px; color: #363C45; }
      .cross::before, .cross::after { content: ""; position: absolute; background: currentColor; }
      .cross::before { left: 6px; top: 0; width: 2px; height: 14px; }
      .cross::after { top: 6px; left: 0; height: 2px; width: 14px; }
      .lockup { position: absolute; left: 130px; top: 112px; display: flex; align-items: center; gap: 22px; }
      .lockup svg { width: 56px; height: 56px; color: #5FCEDB; }
      .lockup .name { font-family: "Space Grotesk", "Geist", sans-serif; font-weight: 600; font-size: 40px; letter-spacing: -0.01em; }
      .lockup .role { font-family: "JetBrains Mono", monospace; font-size: 22px; color: #8792A0; margin-left: 6px; }
      .head { position: absolute; left: 130px; top: 252px; font-family: "Space Grotesk", "Geist", sans-serif; font-weight: 600; font-size: 84px; line-height: 1.04; letter-spacing: -0.02em; margin: 0; }
      .head span { color: #8792A0; }
      .url { position: absolute; left: 130px; bottom: 72px; font-family: "JetBrains Mono", monospace; font-size: 24px; color: #767F8F; }
      .big { position: absolute; right: 96px; bottom: -110px; width: 360px; height: 360px; color: #5FCEDB; opacity: 0.12; }
    </style>
  </head>
  <body>
    <div class="card">
      <i class="cross" style="left:58px;top:76px"></i><i class="cross" style="right:58px;top:76px"></i>
      <i class="cross" style="left:58px;bottom:76px"></i><i class="cross" style="right:58px;bottom:76px"></i>
      <div class="lockup">
        <Fragment set:html={inlineSvg(m, 56)} />
        <span class="name">Marko Stankovic</span>
        <span class="role">AI Engineer</span>
      </div>
      <p class="head">I build AI systems<br /><span>and prove they work.</span></p>
      <Fragment set:html={inlineSvg(m, 360, "big")} />
      <div class="url">markostankovic.org</div>
    </div>
  </body>
</html>
