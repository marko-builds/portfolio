---
// PROTOTYPE chrome for ticket 05, not part of the design under review. Two rows: marks, wordmarks.
import { marks, words } from "./05/_marks";
interface Props { mark: string; word: string }
const { mark, word } = Astro.props;
---

<nav class="sw" aria-label="Mark and wordmark variants">
  <span class="tag">05</span>
  {marks.map((m) => (
    <a href={`/proto/05/${m.slug}-${word}/`} class:list={[{ on: m.slug === mark }]} title={m.label}>{m.slug}</a>
  ))}
  <span class="sep"></span>
  {words.map((w) => (
    <a href={`/proto/05/${mark}-${w.slug}/`} class:list={[{ on: w.slug === word }]} title={w.label}>{w.slug}</a>
  ))}
  <span class="sep"></span>
  <a href={`/proto/05/og/${mark}/`} title="OG card mock, 1200x630">og</a>
</nav>

<style>
  .sw {
    position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 100;
    display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px;
    background: var(--color-text-primary); color: var(--color-bg);
    box-shadow: 0 8px 24px -8px var(--color-backdrop);
    font-family: var(--font-mono); font-size: 11px; white-space: nowrap;
    max-width: calc(100vw - 16px); overflow-x: auto;
  }
  .tag { padding: 4px 8px; color: var(--color-aurora-amber); letter-spacing: 0.08em; }
  .sep { width: 1px; height: 14px; background: var(--color-text-muted); margin-inline: 4px; }
  .sw a { color: var(--color-bg); text-decoration: none; padding: 6px 9px; border-radius: 999px; opacity: 0.7; }
  .sw a.on { background: var(--color-accent); opacity: 1; }
</style>
