---
// Custom 404 (the host serves dist/404.html automatically).
// Marko-directed route addition 2026-07-03; recorded in verify/baseline/BASELINE.md.
// Words: copy-pack-v3 section 11 (slice 11). Repainted to the night register 2026-08-23
// (Marko): the v2 "> GET /this-page;" REPL line retired with the "> ms" mark; the numeral
// keeps its outline, now in the aurora cyan.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
---

<BaseLayout title="404 | Marko Stankovic" description="Nothing buried here. The map was wrong.">
  <SiteNav />

  <main class="wrap">
    <div class="frame">
      <h1>404</h1>
      <p class="msg">Nothing buried here. The map was wrong.</p>
      <div class="links">
        <a class="btn btn-fill" href="/">Back to camp</a>
        <a class="btn" href="/field-journal">Open the field journal</a>
      </div>
    </div>
  </main>

  <style is:global>
    /* Night register: the body-level token remap the post pages, the DeployLog page and
       /call run, so the fixed nav and every role here take the night tokens. */
    body {
      --color-bg: var(--color-night-bg);
      --color-surface-veil: var(--color-night-surface);
      --color-surface-raised: var(--color-night-surface);
      --color-border: var(--color-night-border);
      --color-border-strong: var(--color-night-border);
      --color-text-primary: var(--color-night-text);
      --color-text-secondary: var(--color-night-text-secondary);
      --color-text-muted: var(--color-night-text-secondary);
      --color-accent: var(--color-aurora-cyan);
      --color-accent-dim: var(--color-night-border);
      --color-grid: var(--color-night-border);
      background-color: var(--color-night-bg);
    }
  </style>

  <style>
    .wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-inline: 3.5rem;
    }
    .frame {
      max-width: 62.5rem;
      margin: 0 auto;
      padding-block: 6rem;
      width: 100%;
    }
    @media (max-width: 720px) {
      .wrap { padding-inline: 24px; }
    }
    h1 {
      font-family: var(--font-display, var(--font-sans));
      font-weight: 600;
      font-size: clamp(4rem, 14vw, 9rem);
      line-height: 1;
      letter-spacing: -0.04em;
      margin: 0 0 1.25rem;
      color: transparent;
      -webkit-text-stroke: 0.125rem var(--color-aurora-cyan);
    }
    .msg {
      color: var(--color-text-secondary);
      font-size: 1.125rem;
      margin: 0 0 2.5rem;
    }
    .links { display: flex; flex-wrap: wrap; gap: 0.875rem; }
    .btn {
      font-size: 0.9375rem;
      font-weight: 500;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      border-radius: 0.5rem;
      color: var(--color-night-text);
      border: 1px solid var(--color-night-border);
      transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }
    .btn:hover { border-color: var(--color-aurora-cyan); color: var(--color-aurora-cyan); }
    .btn-fill { background: var(--color-aurora-cyan); color: var(--color-night-bg); border-color: var(--color-aurora-cyan); }
    .btn-fill:hover { background: var(--color-night-bg); color: var(--color-aurora-cyan); }
    @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
  </style>
</BaseLayout>
