</main>

<div class="night tail">
  <section class="sec" id="contact">
    <div class="reveal sec-head">
      <span class="num">04.</span>
      <h2>Send word</h2>
    </div>
    <p class="reveal sec-intro" style="--i:1" set:html={linkify(intros.contact)} />
    <div class="reveal contact" style="--i:2">
      <dl class="facts">
        <div><dt>Based</dt><dd>{identity.location}</dd></div>
        <div><dt>Languages</dt><dd>{identity.languages}</dd></div>
      </dl>
      <ul class="links">
        <li><a href={`mailto:${identity.email}`}>Email</a></li>
        <li><a href={identity.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={identity.rss}>RSS</a></li>
        <li><a href={identity.call} class="call-link">Book a call</a></li>
      </ul>
    </div>
  </section>
<footer class="foot-wrap">
  <div class="foot">
    <p>&copy; 2026 Marko Stankovic</p>
    <p class="foot-meta">Code archaeologist · Belgrade</p>
  </div>
</footer>
</div>

</BaseLayout>

<style>
  /* Alternating bands, Marko 2026-08-22: each section is full-bleed and carries its
     own register; the inner grid is the 1000px column. */
  .sec {
    padding: 3rem 3.5rem 4rem;
    margin: 0;
  }
  .sec > * { max-width: 62.5rem; margin-left: auto; margin-right: auto; }
  .light { background: var(--color-bg); color: var(--color-text-primary); }
  .night {
    background-color: var(--color-night-bg);
    color: var(--color-night-text);
    position: relative;
    isolation: isolate;
  }
  /* Field journal: a "connecting the dots" plexus in the ramp, anchored to the band
     bottom, fixed 300px viewBox height (slice), so it reads the same on any band height. */
  .night > .plexus {
    position: absolute;
    max-width: none;
    margin: 0;
    left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 18.75rem;
    z-index: 0;
    pointer-events: none;
    opacity: 0.7;
  }
  #field-journal { padding-bottom: 15rem; }
  @media (max-width: 720px) { #field-journal { padding-bottom: 11rem; } }
  /* 2D neon lattice for the Send word tail (.tail::before), Marko 2026-08-23: the devlog header's graph
     paper (global.css --color-grid) in the ramp, magenta left to cyan right, fixed
     72px cells so nothing scales with band height, with a glow along the bottom.
     Stand-in for ticket 06's scroll-following graphics. */
  .tail::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--aurora-0), var(--aurora-1) 45%, var(--aurora-2));
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 4.5rem),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 4.5rem);
    mask-image:
      linear-gradient(180deg, transparent 0%, #000 70%),
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 4.5rem),
      repeating-linear-gradient(0deg, #000 0 1px, transparent 1px 4.5rem);
    /* Top layer composites onto the union below it: fade INTERSECT (v lines ADD h lines). */
    -webkit-mask-composite: source-in, source-over, source-over;
    mask-composite: intersect, add, add;
    opacity: 0.55;
  }
  .tail::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    bottom: 0;
    height: 16.25rem;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(43.75rem 10rem at 18% 100%, color-mix(in srgb, var(--aurora-0) 40%, transparent), transparent 70%),
      radial-gradient(43.75rem 10rem at 82% 100%, color-mix(in srgb, var(--aurora-2) 35%, transparent), transparent 70%);
    filter: blur(2px);
  }
  .night > * { position: relative; z-index: 1; }
  .night .sec-head h2, .night .post-title, .night .links a.call-link, .night .facts dd { color: var(--color-night-text); }
  .night .num { color: var(--color-aurora-cyan); }
  .night .sec-intro, .night .post-excerpt, .night .all-link, .night .links a { color: var(--color-night-text-secondary); }
  .night .post-date, .night .facts dt { color: var(--color-night-text-secondary); }
  .night .post-row { border-bottom-color: var(--color-night-border); }
  .night .post-title:hover, .night .all-link:hover, .night .links a:hover { color: var(--color-aurora-cyan); }
  .night .links a:hover { border-bottom-color: var(--color-aurora-cyan); }
  @media (max-width: 720px) {
    .sec { padding: 2.25rem 24px 3rem; }
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }
  .sec-head h2 {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .sec-head h2::before { content: none; }
  .sec-intro {
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
  }
  .all-link {
    margin-left: auto;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .all-link:hover { color: var(--color-accent); }

  .proof-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16.25rem, 1fr));
    gap: 1rem;
  }
  .proof-card {
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    padding: 1.25rem;
    background: var(--color-surface);
    box-shadow: 0 1px 2px var(--color-grid), 0 0.5rem 1.5rem -1rem var(--color-grid);
    position: relative;
    overflow: hidden;
  }
  /* The aurora ramp as a hairline on the card top edge: the one accent the light
     body takes from the hero, in both variants. */
  .proof-card::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: var(--aurora-ramp);
    opacity: 0.8;
  }
  .proof-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .proof-title:hover { color: var(--color-accent); }
  .proof-what {
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0.9rem;
    font-size: 0.94rem;
  }
  .proof-meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .metric {
    font-family: var(--font-mono);
    font-size: 0.85em;
