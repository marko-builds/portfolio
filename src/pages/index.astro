---
// Home, rebuilt 2026-08-23 on the site-v3 register (issues/10-promote-register-home.md;
// issues/prd-site-v3-audience.md; map-site-v3 ticket 03 Answer). Promoted from the
// prototype (c-hybrid = _HeroC + _Body), deleted in slice 14.
//
// Band order and register, top to bottom: hero (night, the live aurora, HeroAurora),
// 01 Artifacts (light), 02 Field journal (night, static star-chart plexus padded under
// the content), 03 Gadgets (light), 04 Send word + footer (one .night.tail carrying the
// flat neon lattice, drawn once on the page). Section ids are the nav's anchors
// (SiteNav.astro). Words: issues/copy-pack-v3.md section 11, verbatim (slice 11); the band
// intros live in src/data/home.ts and render through linkify (inline links, PRD).
//
// The v2 timeline is cut from home (PRD: Legend carries the dates, slice 13).
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroAurora from "../components/HeroAurora.astro";
import { getCollection } from "astro:content";
import { intros, linkify } from "../data/home";

// Same rule as the journal pages: in dev the site shows drafts, in a build it never does.
const recentPosts = (await getCollection("blog"))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Gadgets: the v2 proof cards, verbatim. Every card carries a link, a number and a date,
// each read off the repos themselves on 2026-08-15 (gh repo list + each README).
const proof = [
  {
    name: "skill-vibe-test",
    what: "Does an agent skill still steer the model after ten turns? It runs the skill live in one growing context and an LLM judge scores every probe.",
    metric: "4 probes over 10 turns",
    date: "Jul 2026",
    href: "https://github.com/marko-builds/skill-vibe-test",
  },
  {
    name: "adpreflight",
    what: "Checks a hand-coded HTML5 playable ad against network rule packs before you submit it, so the rejection lands on your machine instead of in an email three days later.",
    metric: "2 network rule packs",
    date: "Aug 2026",
    href: "https://github.com/marko-builds/adpreflight",
  },
  {
    name: "duskpaper",
    what: "Renders animated wallpapers on your machine, at your resolution, from your seed. Every loop is seamless by construction, not by luck.",
    metric: "6 scene engines",
    date: "Jul 2026",
    href: "https://github.com/marko-builds/duskpaper",
  },
];

const products = [
  { name: "deploylog", what: "Release notes from real git history.", href: "/projects/deploylog/", status: "launching" },
  { name: "habitagram", what: "Habit tracking as a journey.", href: null, status: "near launch" },
  { name: "studio", what: "Renders the launch art for both.", href: "/field-journal", status: "internal" },
];

// Identity facts only, all verifiable. No availability statement and no CV link
// (v2 decisions; the /cv redirect route stays either way).
const identity = {
  location: "Belgrade, Serbia",
  languages: "Serbian (native), English",
  email: "contact@markostankovic.org",
  github: "https://github.com/marko-builds",
  linkedin: "https://www.linkedin.com/in/marko-builds/",
  rss: "/rss.xml",
  call: "/call",
};

const pageTitle = "Marko Stankovic. Code archaeologist, forging with AI.";
const pageDescription =
  "Code archaeologist out of Serbia. I forge artifacts with AI companions and keep a field journal. DeployLog digs release notes out of git history.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Marko Stankovic",
  url: "https://markostankovic.org",
  jobTitle: "AI Engineer",
  image: "https://markostankovic.org/portrait.webp",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Belgrade",
    addressCountry: "RS",
  },
  sameAs: [
    "https://github.com/marko-builds",
    "https://www.linkedin.com/in/marko-builds/",
    "https://www.instagram.com/marko.builds/",
  ],
};

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <HeroAurora />

<main id="main">
  <section class="sec light" id="artifacts">
    <div class="reveal sec-head">
      <span class="num">01.</span>
      <h2>Artifacts</h2>
    </div>
    <p class="reveal sec-intro" style="--i:1" set:html={linkify(intros.artifacts)} />
    <ul class="product-rows">
      {products.map((p, i) => (
        <li class="reveal hov product-row" style={`--i:${i}`}>
          {p.href ? <a href={p.href}>{p.name}</a> : <span class="product-name">{p.name}</span>}
          <span class="product-what">{p.what}</span>
