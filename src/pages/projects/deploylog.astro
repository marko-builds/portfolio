---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { Image, getImage } from "astro:assets";
import screenshot1 from "../../assets/screenshots/deploylog-1.png";
const poster1 = await getImage({
  src: screenshot1,
  format: "webp",
  width: 1200,
});

const pageTitle = "DeployLog | Marko Stankovic";
const pageDescription =
  "DeployLog: a changelog & release-notes platform for dev teams. Next.js 16 + Supabase + Stripe, an embeddable widget, a published npm CLI, and a GitHub Action, with AI-generated release notes.";
---

<BaseLayout title={pageTitle} description={pageDescription} codeHighlighting={true}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "DeployLog",
        "description": "Changelog and release-notes platform for developers and small teams: hosted page, embeddable widget, npm CLI, and GitHub Action, with AI-generated release notes.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "author": {
          "@type": "Person",
          "name": "Marko Stankovic",
          "url": "https://markostankovic.org"
        },
        "url": "https://markostankovic.org/projects/deploylog"
      }
    </script>
  </Fragment>

  <style is:global>
    /* Night register (Marko, 2026-08-23): the body-level token remap BlogPost.astro
       runs on the post pages, copied verbatim, so the fixed nav, every Tailwind
       var class on this page, the lightbox and the screenshot frame read the
       night tokens through the roles they already use. */
    body {
      --color-bg: var(--color-night-bg);
      --color-surface-veil: var(--color-night-surface);
      --color-surface-raised: var(--color-night-surface);
      --color-border: var(--color-night-border);
      --color-border-strong: var(--color-night-border);
      --color-text-primary: var(--color-night-text);
      --color-text-secondary: var(--color-night-text-secondary);
      --color-text-muted: var(--color-night-text-secondary);
      --color-accent: var(--color-aurora-cyan);
      --color-accent-dim: var(--color-night-border);
      --color-grid: var(--color-night-border);
      background-color: var(--color-night-bg);
    }
    /* Dark code cards, same rules as the post pages: the hljs theme this page
       loads is github-dark (BaseLayout, codeHighlighting), so the card takes the
       night surface and border and the light-era warm override is lifted. */
    .prose pre code.hljs,
    pre code.hljs {
      background: var(--color-night-surface);
      border-color: var(--color-night-border);
    }
    .prose pre code.hljs .hljs-built_in,
    .prose pre code.hljs .hljs-symbol,
    pre code.hljs .hljs-built_in,
    pre code.hljs .hljs-symbol {
      color: inherit;
    }
    .copy-btn {
      color: var(--color-night-bg);
      background: var(--color-aurora-cyan);
      border-color: var(--color-aurora-cyan);
    }
    .copy-btn:hover {
      color: var(--color-aurora-cyan);
      background: var(--color-night-bg);
      border-color: var(--color-aurora-cyan);
    }
    .copy-btn.copied {
      color: var(--color-night-bg);
      background: var(--color-night-text);
      border-color: var(--color-night-text);
    }
  </style>

  <style>
    /* The site column, built the way field-journal/index.astro builds it: the
       gutter sits on the band and the inner box is the full 1000px, centred.
       At 1440 the h1 left edge lands at 220, at 390 at 24. */
    .band { padding-inline: 56px; }
    .frame { max-width: 1000px; margin-inline: auto; }
    @media (max-width: 720px) {
      .band { padding-inline: 24px; }
    }

    /* The mono entry line, "Artifacts · DeployLog", same shape as the post
       pages' entry line; the band name is the way back to the home band. */
    .entry-line {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      color: var(--color-text-muted);
      margin-bottom: 1.25rem;
    }
    .entry-line a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .entry-line a:hover { color: var(--color-accent); }
    .entry-line .sep { color: var(--color-border-strong); }

    /* Display face on the title and the section heads, as on the post title
       and the home page's .sec-head h2. Written here and not as a Tailwind
       class: global.css sets h1, h2 to mono unlayered, which beats any utility.
       The heads drop the mono "// " prefix the same way .sec-head h2 does. */
    .page-title,
    .sec-h2 {
      font-family: var(--font-display, var(--font-sans));
      font-weight: 600;
      color: var(--color-text-primary);
    }
    .sec-h2 {
      font-size: 1.75rem;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .sec-h2::before { content: none; }

    /* Mono chips on the night border, like the journal index's .post-beat. */
    .chip {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-text-muted);
      border: 1px solid var(--color-border-strong);
      border-radius: 4px;
      padding: 0.25rem 0.75rem;
    }

    /* Inline code in the prose: cyan on the cyan-alpha border token, as on the
       post pages. The old Tailwind tint was an accent at 10 percent alpha. */
    .code-chip {
      font-family: var(--font-mono);
      color: var(--color-accent);
      background: var(--color-accent-dim);
      border-radius: 3px;
    }

    /* Buttons: outline on the night border, aurora cyan on hover. */
    .btn {
      color: var(--color-accent);
      background: transparent;
      border: 1px solid var(--color-border-strong);
      border-radius: 6px;
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .btn:hover {
      color: var(--color-night-bg);
      background: var(--color-aurora-cyan);
      border-color: var(--color-aurora-cyan);
    }

    /* The overview screenshot keeps its frame, on the night tokens. The
       .screenshot-wrap below it reads --color-border through the remap. */
    .shot {
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface-raised);
    }
    .shot img { display: block; width: 100%; height: auto; }

    @media (prefers-reduced-motion: reduce) {
      .btn, .entry-line a { transition: none; }
    }
  </style>

  <!-- ─── NAV ─────────────────────────────────────────────────────────── -->
  <SiteNav active="artifacts" />

  <main>
    <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
    <div class="relative pt-14 band">
      <div class="relative frame py-20">
        <p class="hero-enter entry-line" style="--delay: 0.05s">
          <a href="/#artifacts">Artifacts</a> <span class="sep" aria-hidden="true">·</span> DeployLog
        </p>

        <div class="hero-enter flex flex-wrap gap-2 mb-6" style="--delay: 0.15s">
          <span
            class="chip"
          >
            Launching · solo, full-stack
          </span>
          <span
            class="chip"
          >
            Next.js · Supabase · Stripe
          </span>
        </div>

        <h1
          class="hero-enter page-title text-[var(--color-text-primary)] mb-5"
          style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05; letter-spacing: -0.02em; --delay: 0.3s"
        >
          DeployLog
        </h1>

        <p
          class="hero-enter text-[var(--color-text-secondary)] text-lg max-w-2xl leading-relaxed mb-8"
          style="--delay: 0.5s"
        >
          Keeping a changelog current is the first chore to slip when a release is late.
          DeployLog makes it automatic: publish entries to a hosted page and an <code
            class="code-chip text-base px-1.5"
            >embeddable widget</code
          >, or let a <code
            class="code-chip text-base px-1.5"
            >published npm CLI</code
          > turn git commits into release notes with an LLM. Built solo, end to
          end.
        </p>

        <div class="hero-enter flex flex-wrap gap-3" style="--delay: 0.65s">
          <a
            href="https://deploylog.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="btn inline-flex items-center gap-2 px-5 py-2.5 text-sm"
          >
            Visit deploylog.dev
            <svg
              class="arrow w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="https://www.npmjs.com/package/deploylog"
            target="_blank"
            rel="noopener noreferrer"
            class="github-link btn inline-flex items-center gap-2 px-5 py-2.5 text-sm"
          >
            The CLI on npm
            <svg
              class="arrow w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- ─── OVERVIEW MEDIA ────────────────────────────────────────────────── -->
    <div class="border-t border-[var(--color-border)]/50 py-12 band">
      <div class="frame">
        <div
          class="reveal shot"
        >
          <Image
            src={screenshot1}
            alt="DeployLog landing page: Ship the update. Skip the busywork."
            widths={[600, 1000, 1280]}
            sizes="(max-width: 900px) 100vw, 900px"
            loading="lazy"
          />
        </div>
        <p
          class="reveal text-[var(--color-text-muted)] text-xs font-mono mt-3 text-center"
          style="--delay: 100ms"
        >
          deploylog.dev: the landing page also embeds DeployLog's own live widget
        </p>
      </div>
    </div>

    <!-- ─── ONE PLATFORM, FOUR SURFACES ──────────────────────────────────── -->
    <section id="surfaces" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          One Platform, Four Publishing Surfaces
        </h2>
        <div
          class="reveal max-w-3xl space-y-5 text-[var(--color-text-secondary)] leading-relaxed"
          style="--delay: 100ms"
        >
          <p>
            A changelog is only useful where your users already are, so a single
            entry written once in the dashboard fans out to four surfaces: a
            hosted, SSR changelog page with per-entry canonical URLs and RSS/JSON
            feeds; an <strong class="text-[var(--color-text-primary)] font-medium"
              >embeddable widget</strong
            > (vanilla TypeScript in a Shadow DOM, bundled with esbuild, no
            framework dependency) dropped in with one script tag; a <strong
              class="text-[var(--color-text-primary)] font-medium">published npm CLI</strong
            >; and a GitHub Action that publishes straight from a Release.
          </p>
          <p>
            The two write-paths (dashboard and CLI/Action) hit the same API but
            never share an auth method. See below.
          </p>
        </div>
        <div class="reveal mt-8 max-w-3xl" style="--delay: 150ms">
          <pre><code class="language-html" set:text={`<!-- One script tag embeds the live changelog widget -->
<script
  src="https://cdn.deploylog.dev/widget.js"
  data-project="your-project-slug"
  defer
></script>`} /></pre>
        </div>
      </div>
    </section>

    <!-- ─── TWO AUTH MODELS ──────────────────────────────────────────────── -->
    <section id="auth" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          Two Auth Models That Never Mix
        </h2>
        <div
          class="reveal max-w-3xl space-y-5 text-[var(--color-text-secondary)] leading-relaxed"
          style="--delay: 100ms"
        >
          <p>
            The dashboard authenticates with a Supabase cookie session and runs
            every query through the anon key, so Postgres <strong
              class="text-[var(--color-text-primary)] font-medium">Row-Level Security</strong
            > does the access control. The CLI and integrations authenticate with
            a <code
              class="code-chip text-sm px-1"
              >dk_</code
            >-prefixed API key (stored only as a SHA-256 hash) and run through the
            service-role client, which bypasses RLS, so those endpoints must
            filter by <code
              class="code-chip text-sm px-1"
              >org_id</code
            > explicitly. The rule that keeps it safe: a given route handler uses
            exactly one of these, never both. CLI-only routes live under their own
            <code
              class="code-chip text-sm px-1"
              >/api/cli/*</code
            > namespace.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── PLAN GATING + BILLING ────────────────────────────────────────── -->
    <section id="billing" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          Capability-Based Plan Gating + Stripe Billing
        </h2>
        <div
          class="reveal max-w-3xl space-y-5 text-[var(--color-text-secondary)] leading-relaxed"
          style="--delay: 100ms"
        >
          <p>
            Every paid feature reads through one primitive (<code
              class="code-chip text-sm px-1"
              >can(org, capability)</code
            >) backed by a truth table keyed on the org's plan. Adding a new
            gated feature is one row in the table plus one call at the gate site,
            rather than scattering <code
              class="code-chip text-sm px-1"
              >plan === "pro"</code
            > checks across the codebase. Stripe is the source of truth for plan
            state: Checkout and the Customer Portal drive everything, and a
            webhook reconciles the org's plan on every subscription change, with a
            <code
              class="code-chip text-sm px-1"
              >stripe_events</code
            > table providing idempotency.
          </p>
        </div>
        <div class="reveal mt-8 max-w-3xl" style="--delay: 150ms">
          <pre><code class="language-typescript" set:text={`// src/lib/plan.ts: one source of truth for every feature gate
export function can(
  org: { plan: Plan } | null,
  capability: Capability,
): boolean {
  return CAPABILITIES[org?.plan ?? "free"].includes(capability);
}

// Gate site: projects API
if (!can(org, "unlimited_projects") && projectCount >= FREE_PROJECT_LIMIT) {
  return error("PLAN_LIMIT", "Upgrade to add more projects", 403);
}`} /></pre>
        </div>
      </div>
    </section>

    <!-- ─── AI RELEASE NOTES ─────────────────────────────────────────────── -->
    <section id="ai-notes" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          AI Release Notes, Shared by CLI and Dashboard
        </h2>
        <div
          class="reveal max-w-3xl space-y-5 text-[var(--color-text-secondary)] leading-relaxed"
          style="--delay: 100ms"
        >
          <p>
            Both the dashboard editor and the CLI can turn raw commit messages
            into a clean, user-facing entry (title, type, Markdown body) with
            Claude Haiku. The two surfaces are thin auth shells over one shared
            service: the prompt, the JSON-validated output, the rate limit, and
            the free-tier monthly cap all live in a single module, so the two
            entry points can't drift apart. From the terminal it's one flag:
          </p>
        </div>
        <div class="reveal mt-8 max-w-3xl" style="--delay: 150ms">
          <pre><code class="language-bash" set:text={`# Generate release notes from git, rewritten by an LLM, and publish
deploylog push --from-git --ai-summarize`} /></pre>
        </div>
      </div>
    </section>

    <!-- ─── STACK ─────────────────────────────────────────────────────────── -->
    <section id="stack" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">Stack</h2>
        <div
          class="reveal grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3 max-w-3xl text-[var(--color-text-secondary)]"
          style="--delay: 100ms"
        >
          <p><span class="text-[var(--color-text-primary)] font-medium">Frontend / API:</span> Next.js 16 (App Router, RSC), React 19, TypeScript (strict), Tailwind v4</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Database / auth:</span> Supabase (PostgreSQL + RLS, GitHub OAuth)</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Payments:</span> Stripe (Checkout, Portal, webhooks)</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Email:</span> Resend + React Email templates</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">AI:</span> Anthropic Claude (Haiku) for release-note summarization</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Editor / widget:</span> CodeMirror 6 · vanilla-TS Shadow-DOM widget (esbuild)</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Infra:</span> Vercel · Cloudflare Pages (widget CDN) · Upstash · Sentry</p>
          <p><span class="text-[var(--color-text-primary)] font-medium">Distribution:</span> npm CLI · GitHub Action on the Marketplace</p>
        </div>
      </div>
    </section>

    <!-- ─── SCREENSHOTS ───────────────────────────────────────────────────── -->
    <section
      id="screenshots"
      class="py-20 border-t border-[var(--color-border)]/50 band"
      data-screenshots={poster1.src}
    >
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          Screenshots
        </h2>
        <div class="grid grid-cols-1 gap-4 max-w-3xl">
          <div class="reveal" style="--delay: 0ms">
            <div
              class="screenshot-wrap"
              role="button"
              tabindex="0"
              aria-label="Open screenshot 1"
              data-index="0"
            >
              <Image
                src={screenshot1}
                alt="DeployLog landing page hero and live widget"
                loading="lazy"
                widths={[400, 800, 1200]}
                sizes="(max-width: 640px) 100vw, 100vw"
              />
            </div>
            <p class="text-[var(--color-text-muted)] text-xs font-mono mt-2">
              deploylog.dev: hero, CTAs, and the self-hosted live widget
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── RETROSPECTIVE ─────────────────────────────────────────────────── -->
    <section id="retrospective" class="py-20 border-t border-[var(--color-border)]/50 band">
      <div class="frame">
        <h2 class="reveal sec-h2 mb-10">
          Retrospective
        </h2>
        <ul class="reveal space-y-4 max-w-3xl" style="--delay: 100ms">
          <li class="flex gap-3 text-[var(--color-text-secondary)] leading-relaxed">
            <span class="text-[var(--color-accent)] font-mono mt-0.5 shrink-0">//</span>
            <span>
              <strong class="text-[var(--color-text-primary)] font-medium"
                >One capability table beats scattered plan checks.</strong
              >
              Routing every gate through <code
                class="code-chip text-sm px-1"
                >can()</code
              > meant adding the Pro tier late in development touched one file, not
              twenty.
            </span>
          </li>
          <li class="flex gap-3 text-[var(--color-text-secondary)] leading-relaxed">
            <span class="text-[var(--color-accent)] font-mono mt-0.5 shrink-0">//</span>
            <span>
              <strong class="text-[var(--color-text-primary)] font-medium"
                >Sharing one service across CLI and dashboard prevents drift.</strong
              >
              The AI-summarize logic lives once; the two surfaces are just auth +
              transport. The same shape would have saved time if applied to more
              dual-surface endpoints from the start.
            </span>
          </li>
          <li class="flex gap-3 text-[var(--color-text-secondary)] leading-relaxed">
            <span class="text-[var(--color-accent)] font-mono mt-0.5 shrink-0">//</span>
            <span>
              <strong class="text-[var(--color-text-primary)] font-medium"
                >The widget being framework-free was the right call.</strong
              >
              A Shadow-DOM vanilla-TS bundle drops into any site without pulling in
              React or clashing with host styles, the constraint that made it
              small also made it universal.
            </span>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <!-- ─── FOOTER ────────────────────────────────────────────────────────── -->
  <footer class="border-t border-[var(--color-border)]/50 py-8 band">
    <div
      class="frame flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-[var(--color-text-secondary)] text-sm">© 2026 Marko Stankovic</p>
      <a
        href="/"
        class="nav-link text-[var(--color-text-muted)] text-xs font-mono hover:text-[var(--color-text-secondary)] transition-colors duration-150"
      >
        back to home
      </a>
    </div>
  </footer>

  <!-- ─── LIGHTBOX ──────────────────────────────────────────────────────── -->
  <div
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Screenshot viewer"
    class="fixed inset-0 z-[200] items-center justify-center"
  >
    <div id="lightbox-backdrop" class="absolute inset-0 bg-[var(--color-backdrop)]/95"></div>
    <div id="lightbox-content" class="relative z-10 flex items-center gap-3 px-4">
      <button id="lightbox-prev" class="lb-btn" aria-label="Previous screenshot">
        <svg
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path></svg
        >
      </button>
      <img id="lightbox-img" src="data:," alt="Project screenshot" />
      <button id="lightbox-next" class="lb-btn" aria-label="Next screenshot">
        <svg
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path></svg
        >
      </button>
    </div>
    <button id="lightbox-close" class="lb-btn z-10" aria-label="Close lightbox">
      <svg
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
  </div>

  <script>
    // @ts-ignore
    if (typeof hljs !== "undefined") hljs.highlightAll();

    document.querySelectorAll("pre").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "pre-wrap";
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "copy";
      btn.setAttribute("aria-label", "Copy code");
      wrap.appendChild(btn);

      btn.addEventListener("click", () => {
        const code = pre.querySelector("code");
        const text = code?.textContent ?? "";
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = "copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "copy";
            btn.classList.remove("copied");
          }, 2000);
        });
      });
    });

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const revealEls = document.querySelectorAll(".reveal");
    if (!prefersReduced) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 },
      );
      revealEls.forEach((el) => obs.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add("visible"));
    }

    const lightbox = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img");
    const lbPrev = document.getElementById("lightbox-prev");
    const lbNext = document.getElementById("lightbox-next");
    const lbClose = document.getElementById("lightbox-close");
    const lbBackdrop = document.getElementById("lightbox-backdrop");
    const section = document.getElementById("screenshots");
    const lbScreenshots = (section?.dataset.screenshots ?? "")
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean);
    let lbIndex = 0;
    let lbPrevFocus = null;

    function lbShow(index) {
      lbIndex = index;
      lbPrevFocus = document.activeElement;
      lbUpdate();
      lightbox.style.display = "flex";
      requestAnimationFrame(() => {
        lightbox.classList.add("lb-open");
        document.body.style.overflow = "hidden";
        lbClose.focus();
      });
    }
    function lbHide() {
      lightbox.classList.remove("lb-open");
      lightbox.addEventListener(
        "transitionend",
        () => {
          lightbox.style.display = "none";
          document.body.style.overflow = "";
          lbPrevFocus?.focus();
        },
        { once: true },
      );
    }
    function lbUpdate() {
      lbImg.src = lbScreenshots[lbIndex];
      lbImg.alt = `Screenshot ${lbIndex + 1} of ${lbScreenshots.length}`;
      lbPrev.disabled = lbIndex === 0;
      lbNext.disabled = lbIndex === lbScreenshots.length - 1;
    }

    document.querySelectorAll(".screenshot-wrap").forEach((wrap) => {
      const open = () => lbShow(parseInt(wrap.dataset.index ?? "0", 10));
      wrap.addEventListener("click", open);
      wrap.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open();
        }
      });
    });
    lbClose.addEventListener("click", lbHide);
    lbBackdrop.addEventListener("click", lbHide);
    lbPrev.addEventListener("click", () => {
      if (lbIndex > 0) {
        lbIndex--;
        lbUpdate();
      }
    });
    lbNext.addEventListener("click", () => {
      if (lbIndex < lbScreenshots.length - 1) {
        lbIndex++;
        lbUpdate();
      }
    });
    lightbox.addEventListener("keydown", (e) => {
      if (e.key === "Escape") lbHide();
      else if (e.key === "ArrowLeft" && lbIndex > 0) {
        lbIndex--;
        lbUpdate();
      } else if (e.key === "ArrowRight" && lbIndex < lbScreenshots.length - 1) {
        lbIndex++;
        lbUpdate();
      }
    });
  </script>
</BaseLayout>
