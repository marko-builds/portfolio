---
// Shared top nav for every page, rebuilt 2026-08-23 on the site-v3 register
// (issues/10-promote-register-home.md; map-site-v3 tickets 05 and 11): the fold mark
// plus the full-name wordmark in the display face (the wordmark hides below 480px,
// where the name and five links do not fit), and the five labels
// Artifacts · Field journal · Gadgets · Legend · Send word. `> ms` retired here.
//
// Two registers, one component. The default is the fixed light bar every inner page
// carries. `register="night"` renders it in flow, inside the home hero band, in the
// night tokens, so the aurora runs behind it (the prototype's _HeroC nav).
//
// The fold mark geometry is public/favicon.svg's path (the ticket 05 prototype that
// generated it was deleted in slice 14); copied, not imported.
type Key = "artifacts" | "journal" | "gadgets" | "legend" | "contact";
interface Props {
  active?: Key;
  register?: "light" | "night";
}
const { active, register = "light" } = Astro.props;

const links: { href: string; key: Key; label: string }[] = [
  { href: "/#artifacts", key: "artifacts", label: "Artifacts" },
  { href: "/field-journal", key: "journal", label: "Field journal" },
  { href: "/#gadgets", key: "gadgets", label: "Gadgets" },
  { href: "/about", key: "legend", label: "Legend" },
  { href: "/#contact", key: "contact", label: "Send word" },
];
---

<header class:list={["site-nav", register]}>
  <nav aria-label="Site">
    <a class="mark" href="/" aria-label="Marko Stankovic, home">
      <svg class="mk" viewBox="0 0 512 512" width="22" height="22" aria-hidden="true">
        <path d="M136 352L200 166L256 300L312 166L376 352" fill="none" stroke="currentColor" stroke-width="52" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="word">Marko Stankovic</span>
    </a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class:list={[{ active: active === l.key }]} aria-current={active === l.key ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-veil);
    backdrop-filter: blur(3px);
  }
  /* In-band night register: static, inside the hero, above the canvas. */
  .site-nav.night {
    position: relative;
    z-index: 1;
    border-bottom-color: var(--color-night-border);
    background: none;
    backdrop-filter: none;
  }
  nav {
    max-width: 62.5rem;
    margin: 0 auto;
    padding-inline: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-primary);
    text-decoration: none;
    flex: none;
  }
  .mk { color: var(--color-accent); flex: none; width: 1.375rem; height: 1.375rem; }
  .word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .night .mark { color: var(--color-night-text); }
  .night .mk { color: var(--color-aurora-cyan); }
  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: 0.375rem;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  ul a:hover { color: var(--color-text-primary); }
  ul a.active { color: var(--color-accent); }
  .night ul a { color: var(--color-night-text-secondary); }
  .night ul a:hover { color: var(--color-night-text); }
  .night ul a.active { color: var(--color-aurora-cyan); }
  @media (max-width: 720px) {
    nav { padding-inline: 28px; }
    .night nav { padding-inline: 24px; }
    ul { gap: 16px; }
    ul a { font-size: 0.85rem; }
  }
  /* Five labels plus the wordmark need ~590px (measured: with the wordmark back at 481px
     the row's right edge sat at 555px and "Send word" was clipped). So the wordmark hides
     below 600px, not 480px, and the list may wrap as a last resort rather than clip. */
  @media (max-width: 600px) {
    .word { display: none; }
    nav { height: auto; min-height: 56px; padding-block: 6px; }
    ul { flex-wrap: wrap; justify-content: flex-end; row-gap: 0; }
  }
  @media (max-width: 480px) {
    nav, .night nav { padding-inline: 16px; }
    ul { gap: 10px; }
    ul a { font-size: 0.75rem; }
  }
</style>
